@model List<JW_Management.Models.Tenant>
@{
    ViewData["Title"] = "Escolher congregação";
}
<div class="container" style="max-width:560px">
    <div class="panel-card">
        <h1 class="title is-4">Escolha a congregação</h1>
        <p class="subtitle is-6">A sua conta tem acesso a mais do que uma congregação.</p>
        <form method="post" class="items">
            @foreach (var t in Model)
            {
                <button class="button is-info is-light" style="justify-content:flex-start;min-height:3.2rem" name="tenantId" value="@t.Id">
                    <span class="icon"><i class="fa-solid fa-people-roof"></i></span><span>@t.Nome</span>
                </button>
            }
        </form>
    </div>
</div>
