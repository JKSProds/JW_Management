@model JW_Management.Models.ConfiguracaoModel
@{
    ViewData["Title"] = "Configuração";
    var emailPronto = !string.IsNullOrWhiteSpace(Model.EmailRemetente) && !string.IsNullOrWhiteSpace(Model.EmailHost) && !string.IsNullOrWhiteSpace(Model.EmailPorta) && Model.EmailPasswordDefinida;
}

<div class="container" style="max-width:760px">
    <div class="page-head">
        <div class="head-title">
            <div><h1>Configuração</h1></div>
        </div>
    </div>

    @if (TempData["Guardado"] != null)
    {
        <div class="notice is-ok" role="status">
            <span class="icon"><i class="fa-solid fa-circle-check"></i></span>
            <span>Guardado. O email tem efeito no próximo envio; o OIDC e o proxy só depois de reiniciar a aplicação.</span>
        </div>
    }
    <form method="post" id="frmConfig">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="notice is-bad" role="alert">
                <span class="icon"><i class="fa-solid fa-circle-exclamation"></i></span>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <details class="panel-card cfg-sec">
            <summary><h2>Início de sessão (OIDC)</h2><span class="tag @(string.IsNullOrWhiteSpace(Model.Authority) || !Model.ClientSecretDefinido ? "is-warning" : "is-success")">@(string.IsNullOrWhiteSpace(Model.Authority) || !Model.ClientSecretDefinido ? "Por definir" : "Definido")</span></summary>
            <div class="field">
                <label class="label" asp-for="Authority">Authority (emissor OIDC)</label>
                <input class="input" asp-for="Authority" placeholder="https://id.exemplo.pt" />
                <p class="field-hint">Tem de ser um URL https.</p>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="ClientId">Client ID</label>
                    <input class="input" asp-for="ClientId" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="label" asp-for="ClientSecret">
                        Client secret
                        <span class="tag @(Model.ClientSecretDefinido ? "is-success" : "is-light") ml-1">@(Model.ClientSecretDefinido ? "definido" : "não definido")</span>
                    </label>
                    <input class="input" type="password" asp-for="ClientSecret" autocomplete="new-password"
                           placeholder="Deixe vazio para manter o atual" />
                </div>
            </div>
            <label class="checkbox cfg-check">
                <input type="checkbox" asp-for="SomenteOidc" />
                <span><strong>Permitir apenas OAuth</strong><br><span class="field-hint">Desativa o início de sessão com palavra-passe. Exige Authority, Client ID e Client secret definidos. Se o OIDC ficar mal configurado, o acesso só se recupera na base de dados master (<code>sys_config</code>, chave <code>Auth:SomenteOidc</code>).</span></span>
            </label>
        </details>

        <details class="panel-card cfg-sec" open>
            <summary><h2>Email</h2><span class="tag @(emailPronto ? "is-success" : "is-warning")">@(emailPronto ? "Configurado" : "Por definir")</span></summary>
            <p class="field-hint" style="margin-bottom:.8rem">Servidor de envio (SMTP) usado por esta congregação nos pedidos de literatura, acessos e programas. A porta 465 liga em TLS; a 587 usa STARTTLS.</p>
            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="EmailRemetente">Email do remetente</label>
                    <input class="input" type="email" asp-for="EmailRemetente" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="label" asp-for="EmailPassword">
                        Palavra-passe
                        <span class="tag @(Model.EmailPasswordDefinida ? "is-success" : "is-light") ml-1">@(Model.EmailPasswordDefinida ? "definida" : "não definida")</span>
                    </label>
                    <input class="input" type="password" asp-for="EmailPassword" autocomplete="new-password" placeholder="Deixe vazio para manter a atual" />
                </div>
                <div class="field">
                    <label class="label" asp-for="EmailHost">Servidor SMTP</label>
                    <input class="input" asp-for="EmailHost" placeholder="smtp.gmail.com" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="label" asp-for="EmailPorta">Porta</label>
                    <input class="input" asp-for="EmailPorta" inputmode="numeric" placeholder="465" autocomplete="off" />
                </div>
            </div>
            <p class="field-hint">A palavra-passe é guardada cifrada. Se for guardada num ambiente com outra chave de cifra, os outros ambientes deixam de a conseguir ler.</p>
            <h3 class="cfg-sub">Comum a todas as congregações</h3>
            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="MailNome">Nome do remetente</label>
                    <input class="input" asp-for="MailNome" placeholder="Por omissão, o nome da congregação" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="label" asp-for="MailBcc">Cópia (Bcc)</label>
                    <input class="input" type="email" asp-for="MailBcc" placeholder="Vazio = sem cópia" autocomplete="off" />
                    <p class="field-hint">Recebe cópia dos emails individuais. Não recebe os envios de programas.</p>
                </div>
            </div>
        </details>

        <details class="panel-card cfg-sec">
            <summary><h2>Avançado</h2></summary>
            <div class="field">
                <label class="label" asp-for="KnownProxy">IP do proxy (Caddy)</label>
                <input class="input" asp-for="KnownProxy" inputmode="decimal" />
            </div>
        </details>

        <div class="mt-5">
            <button class="button is-info" type="submit">
                <span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar configuração</span>
            </button>
        </div>
    </form>
</div>
