@model JW_Management.Models.Publicador
@{
    ViewData["Title"] = "Publicador";
    var movimentos = Model.Movimentos ?? new();
    var pedidos = Model.Pedidos ?? new();
    var territorios = Model.Territorios ?? new();
    var iniciais = string.Concat((Model.Nome ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(1).Select(p => p[0])) +
                   string.Concat((Model.Nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Skip(1).Reverse().Take(1).Select(p => p[0]));
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <span class="avatar" style="width:46px;height:46px;font-size:1rem" aria-hidden="true">@iniciais.ToUpper()<img src="~/Publicadores/Foto/@Model.Id" alt="" loading="lazy" onerror="this.remove()"></span>
            <div>
                <h1>@Model.Nome</h1>
                <p>@Model.Role · Nº @Model.Id</p>
            </div>
        </div>
        <div class="head-actions">
            <a class="button is-info is-light" href="~/Publicadores">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Publicadores</span>
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-right-left", "Movimentos de literatura", movimentos.Count.ToString(), "", ""),
        ("fa-clipboard-list", "Pedidos em aberto", pedidos.Count.ToString(), "", pedidos.Any() ? "is-warn" : ""),
        ("fa-map", "Territórios a trabalhar", territorios.Count.ToString(), "", "") })

    <div class="seg" role="tablist" aria-label="Secções da ficha">
        <button type="button" role="tab" id="tabDados" aria-controls="panDados" aria-selected="true">Dados</button>
        <button type="button" role="tab" id="tabMov" aria-controls="panMov" aria-selected="false">Movimentos<span class="count">@movimentos.Count</span></button>
        <button type="button" role="tab" id="tabPed" aria-controls="panPed" aria-selected="false">Pedidos<span class="count">@pedidos.Count</span></button>
        <button type="button" role="tab" id="tabTer" aria-controls="panTer" aria-selected="false">Territórios<span class="count">@territorios.Count</span></button>
    </div>

    <section id="panDados" role="tabpanel" aria-labelledby="tabDados">
        <form method="post" id="frmPublicador" class="panel-card">
            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="Id">Número</label>
                    <input type="text" class="input" readonly asp-for="Id">
                </div>
                <div class="field">
                    <label class="label" asp-for="Role">Função</label>
                    <input type="text" class="input" readonly disabled asp-for="Role">
                </div>
                <div class="field">
                    <label class="label" asp-for="Nome">Nome</label>
                    <input type="text" class="input" readonly asp-for="Nome">
                </div>
                <div class="field">
                    <label class="label" asp-for="Username">Utilizador</label>
                    <input type="text" class="input" readonly asp-for="Username" autocomplete="off">
                </div>
                <div class="field">
                    <label class="label" for="Password">Palavra-passe</label>
                    <div class="input-action">
                        <div class="control">
                            @* O hash nunca é enviado para o browser: vazio mantém a palavra-passe atual (ver PublicadoresController). *@
                            <input type="password" class="input" id="Password" name="Password" value="" autocomplete="new-password" placeholder="Deixe vazio para manter">
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <button type="button" class="button btn-icon" data-action="novaSenha" aria-label="Gerar e enviar nova palavra-passe por email" title="Gerar e enviar nova palavra-passe por email"><i class="fa-solid fa-key"></i></button>
                        }
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="Grupo_Id">Grupo</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select asp-for="Grupo.Id" asp-items="@(new SelectList(ViewBag.Grupos, "Value", "Text", Model.Grupo!.Id))"></select>
                        </div>
                        <span class="icon is-left"><i class="fa-solid fa-user-group"></i></span>
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="field">
                        <label class="label" for="TipoUtilizador">Função (permissões)</label>
                        <div class="control has-icons-left">
                            <div class="select is-fullwidth">
                                <select id="TipoUtilizador" name="TipoUtilizador" asp-items="@(new SelectList(ViewBag.Funcoes, "Value", "Text", Model.TipoUtilizador.ToString()))"></select>
                            </div>
                            <span class="icon is-left"><i class="fa-solid fa-user-shield"></i></span>
                        </div>
                        <span class="field-hint">Só tem efeito no próximo início de sessão do utilizador.</span>
                    </div>
                }
                <div class="field">
                    <label class="label" asp-for="Email">Email</label>
                    <div class="input-action">
                        <div class="control"><input type="email" class="input" asp-for="Email" autocomplete="off"></div>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <a class="button btn-icon" href="mailto:@Model.Email" aria-label="Enviar email" title="Enviar email"><i class="fa-solid fa-paper-plane"></i></a>
                        }
                    </div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Telemovel">Telemóvel</label>
                    <div class="input-action">
                        <div class="control"><input type="tel" class="input" asp-for="Telemovel" autocomplete="off"></div>
                        @if (!string.IsNullOrEmpty(Model.Telemovel))
                        {
                            <a class="button btn-icon is-ok-hover" href="tel:@Model.Telemovel" aria-label="Telefonar" title="Telefonar"><i class="fa-solid fa-phone"></i></a>
                        }
                    </div>
                </div>
                <div class="field span-all">
                    <label class="label" asp-for="Morada">Morada</label>
                    <div class="input-action">
                        <div class="control"><input type="text" class="input" asp-for="Morada" autocomplete="off"></div>
                        @if (!string.IsNullOrEmpty(Model.Morada))
                        {
                            <a class="button btn-icon" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Morada)" target="_blank" rel="noopener" aria-label="Ver no mapa" title="Ver no mapa"><i class="fa-solid fa-location-dot"></i></a>
                        }
                    </div>
                </div>
            </div>
            <div class="mt-5">
                <button class="button is-success" type="submit" id="btnGuardar">
                    <span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar alterações</span>
                </button>
            </div>
        </form>
    </section>

    <section id="panMov" role="tabpanel" aria-labelledby="tabMov" hidden>
        @if (!movimentos.Any())
        {
            <div class="empty-state"><span class="icon"><i class="fa-solid fa-right-left"></i></span><strong>Sem movimentos</strong>Este publicador ainda não tem movimentos de literatura.</div>
        }
        else
        {
            <div class="items">
                @foreach (var item in movimentos)
                {
                    <article class="item no-thumb">
                        <div class="main">
                            <div class="name">@item.Literatura!.Descricao</div>
                            <div class="meta"><span class="num">@item.DataMovimento.ToString("dd/MM/yyyy HH:mm")</span></div>
                        </div>
                        <div class="side"><div class="qty num @(item.In ? "is-in" : "is-out")">@(item.In ? "+" : "−")@Math.Abs(item.Quantidade)</div></div>
                    </article>
                }
            </div>
        }
    </section>

    <section id="panPed" role="tabpanel" aria-labelledby="tabPed" hidden>
        @if (!pedidos.Any())
        {
            <div class="empty-state"><span class="icon"><i class="fa-solid fa-clipboard-list"></i></span><strong>Sem pedidos</strong>Não há pedidos em aberto para este publicador.</div>
        }
        else
        {
            <div class="items">
                @foreach (var item in pedidos)
                {
                    <article class="item no-thumb">
                        <div class="main">
                            <div class="name">@item.Descricao</div>
                            <div class="meta"><span class="ref-tag">@item.Referencia</span></div>
                        </div>
                        <div class="side"><div class="qty num">@item.Quantidade</div></div>
                    </article>
                }
            </div>
        }
    </section>

    <section id="panTer" role="tabpanel" aria-labelledby="tabTer" hidden>
        @if (!territorios.Any())
        {
            <div class="empty-state"><span class="icon"><i class="fa-solid fa-map"></i></span><strong>Sem territórios</strong>Não há territórios a trabalhar por este publicador.</div>
        }
        else
        {
            <div class="items">
                @foreach (var item in territorios)
                {
                    <article class="item no-thumb">
                        <div class="main">
                            <div class="name">@item.Nome</div>
                            <div class="meta"><span class="num">Nº @item.Id</span><span class="num">desde @item.UltimoMovimento?.DataMovimento</span></div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
    // Guardar sem recarregar a página; um valor vazio na palavra-passe mantém a atual.
    App.$('#frmPublicador').addEventListener('submit', e => {
        e.preventDefault();
        App.run(App.$('#btnGuardar'), async () => {
            await App.api('POST', location.pathname, Object.fromEntries(new FormData(e.target)));
            App.$('#Password').value = ''; notify('Dados guardados.');
        }, 'Não foi possível guardar os dados.');
    });

    App.on('novaSenha', async btn => {
        if (!await App.confirm({ title: 'Nova palavra-passe', text: 'Gerar uma nova palavra-passe e enviá-la por email para @Model.Email? A atual deixa de funcionar.', ok: 'Gerar e enviar', danger: false })) return;
        App.run(btn, async () => { await App.api('GET', '/Publicadores/Senha/@Model.Id'); notify('Nova palavra-passe gerada e enviada.'); },
            'Não foi possível gerar a palavra-passe.');
    });
</script>
}
