@model IEnumerable<JW_Management.Models.Publicador>
@{
    ViewData["Title"] = "Publicadores";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div>
                <h1>Publicadores</h1>
                
            </div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info is-light" data-open="modalSync">
                <span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Sincronizar com o Hourglass</span>
            </button>
            <button type="button" class="button is-info" data-open="modalNovo">
                <span class="icon"><i class="fa-solid fa-user-plus"></i></span><span>Novo publicador</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-users", "Publicadores", Model.Count().ToString(), "sTot", ""),
        ("fa-envelope", "Com email", Model.Count(p => !string.IsNullOrWhiteSpace(p.Email)).ToString(), "sMail", "is-ok"),
        ("fa-phone", "Com telemóvel", Model.Count(p => !string.IsNullOrWhiteSpace(p.Telemovel)).ToString(), "sTel", "") })

    @{
        string Slug(string? r) => (r ?? "").ToLowerInvariant().Replace(' ', '-');
        var funcoes = Model.Select(p => p.Role).Where(r => !string.IsNullOrWhiteSpace(r)).Distinct().OrderBy(r => r).ToList();
    }
    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar por nome, função, grupo ou contacto" aria-label="Pesquisar publicadores">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar">
            <button type="button" class="chip" data-type="0" aria-pressed="true">Todos</button>
            <button type="button" class="chip" data-type="mail" aria-pressed="false"><i class="fa-solid fa-envelope fa-xs"></i> Com email</button>
            <button type="button" class="chip" data-type="tel" aria-pressed="false"><i class="fa-solid fa-phone fa-xs"></i> Com telemóvel</button>
            <button type="button" class="chip" data-type="semcontacto" aria-pressed="false">Sem contacto</button>
            @foreach (var f in funcoes) { <button type="button" class="chip" data-type="r-@Slug(f)" aria-pressed="false">@f</button> }
        </div>
    </div>

    <div id="lista" class="pub-grid">
        @foreach (var item in Model)
        {
            var partes = item.Nome!.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var iniciais = (partes.Length > 0 ? partes[0][..1] : "?") + (partes.Length > 1 ? partes[^1][..1] : "");
            var temMail = !string.IsNullOrWhiteSpace(item.Email); var temTel = !string.IsNullOrWhiteSpace(item.Telemovel);
            var tipos = string.Join(' ', new[] { temMail ? "mail" : null, temTel ? "tel" : null, !temMail && !temTel ? "semcontacto" : null, "r-" + Slug(item.Role) }.Where(x => x != null));
            <article class="item pub-card" data-id="@item.Id" data-mail="@(temMail ? 1 : 0)" data-tel="@(temTel ? 1 : 0)" data-type="@tipos" data-search="@item.Nome @item.Role @item.Grupo?.Nome @item.Email @item.Telemovel @item.Id">
                <a class="pub-main" href="~/Publicadores/Publicador/@item.Id" aria-label="Abrir ficha de @item.Nome">
                    <span class="avatar pub-avatar" aria-hidden="true">@iniciais.ToUpper()</span>
                    <span class="pub-info">
                        <span class="name">@item.Nome</span>
                        <span class="meta">
                            <span class="tag is-light">@item.Role</span>
                            @if (!string.IsNullOrWhiteSpace(item.Grupo?.Nome)) { <span><i class="fa-solid fa-user-group fa-xs"></i> @item.Grupo.Nome</span> }
                            <span class="num">Nº @item.Id</span>
                        </span>
                    </span>
                </a>
                <div class="pub-acts acts">
                    @if (temMail) { <a class="button btn-icon" href="mailto:@item.Email" aria-label="Enviar email a @item.Nome" title="@item.Email"><i class="fa-solid fa-envelope"></i></a> }
                    @if (temTel) { <a class="button btn-icon" href="tel:@item.Telemovel" aria-label="Ligar a @item.Nome" title="@item.Telemovel"><i class="fa-solid fa-phone"></i></a> }
                    <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar @item.Nome" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                </div>
            </article>
        }
    </div>

    <div id="vazio" class="empty-state" hidden>
        <span class="icon"><i class="fa-solid fa-user-slash"></i></span>
        <strong>Não foram encontrados publicadores</strong>
        Experimente outra pesquisa.
    </div>
</div>

<div id="modalNovo" class="modal" role="dialog" aria-modal="true" aria-labelledby="tNovo">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tNovo"><span class="icon"><i class="fa-solid fa-id-card"></i></span><span>Novo publicador</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtNomeNovoPublicador">Nome</label>
                <input type="text" class="input" id="txtNomeNovoPublicador" placeholder="Nome completo">
                <p class="field-hint">Os restantes dados preenche-os na ficha do publicador.</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criar" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Criar</span></button>
        </footer>
    </div>
</div>

<div id="modalSync" class="modal" role="dialog" aria-modal="true" aria-labelledby="tSy" data-persist="1">
    <div class="modal-background"></div>
    <div class="modal-card is-wide">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tSy"><span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Sincronizar publicadores com o Hourglass</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div id="syPasso1">
                <p class="modal-body-text mb-4">Liga cada publicador ao utilizador do Hourglass (por email ou nome) e propõe preencher email, telemóvel, morada e grupo, ou acrescentar quem ainda não existe. Não altera funções nem palavras-passe. Só se fazem leituras no Hourglass.</p>
                <div id="syBloco">
                <ol class="steps">
                    <li>Abra o <a href="https://app.hourglass-app.com/v2/page/app/scheduling/mm" target="_blank" rel="noopener">Hourglass</a> com a sessão iniciada, prima <kbd>F12</kbd> e abra o separador <b>Rede</b>.</li>
                    <li>Num qualquer pedido da lista (por exemplo um cujo nome é um intervalo de datas, como <b>2026-11-01_2026-11-30</b>): botão direito, <b>Copiar</b>, <b>Copiar como cURL</b>, e cole abaixo.</li>
                </ol>
                <div class="field">
                    <label class="label" for="syCookie">Pedido copiado (ou só a cookie)</label>
                    <textarea class="textarea" id="syCookie" rows="3" spellcheck="false" autocomplete="off" placeholder="curl 'https://app.hourglass-app.com/...' -H 'Cookie: ...'"></textarea>
                    <p class="field-hint">A sessão fica guardada no servidor (só em memória) durante 6 horas.</p>
                </div>
                </div>
            </div>
            <div id="syPasso2" hidden></div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" id="syObter" data-action="syObter" data-submit><span class="icon"><i class="fa-solid fa-cloud-arrow-down"></i></span><span>Comparar</span></button>
            <button type="button" class="button is-success" id="syAplicar" data-action="syAplicar" hidden><span class="icon"><i class="fa-solid fa-check"></i></span><span>Aplicar selecionados</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    App.filtro({
        lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio', semUrl: true,
        aoAplicar: v => App.stats({ sTot: v.length, sMail: v.filter(i => i.dataset.mail === '1').length, sTel: v.filter(i => i.dataset.tel === '1').length })
    });

    App.on('apagar', async btn => {
        const it = btn.closest('.item'), nome = App.$('.name', it).textContent.trim();
        if (!await App.confirm({ title: 'Apagar publicador', text: 'Apagar «' + nome + '» e todos os movimentos e pedidos associados? Esta ação é irreversível.', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Publicadores/Publicador/', { id: it.dataset.id, delete: true }); App.removeItem(it); notify('Publicador apagado.'); },
            'Não foi possível apagar o publicador. Pode não ter permissões para apagar este utilizador.');
    });

    App.on('criar', btn => App.run(btn, async () => {
        const nome = App.$('#txtNomeNovoPublicador').value.trim();
        if (!nome) return App.campo('#txtNomeNovoPublicador', 'Indique o nome do publicador.');
        const todos = await App.api('GET', '/Publicadores/ObterPublicadores/');
        const id = Math.max(0, ...todos.map(p => p.id)) + 1;
        await App.api('POST', '/Publicadores/Publicador/', { nome: nome, id: id });
        location.href = '/Publicadores/Publicador/' + id;
    }, 'Não foi possível criar o publicador.'));

    // ---------- Sincronização com o Hourglass ----------
    (function () {
        let prev = null; App.hgSessao('#syBloco');
        const esc = t => String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const rotulo = { Email: 'Email', Telemovel: 'Telemóvel', Morada: 'Morada', Grupo: 'Grupo' };

        App.on('syObter', btn => App.run(btn, async () => {
            const cookie = App.hgCookie('#syCookie'); if (cookie === null) return;
            const r = await fetch('/Publicadores/HourglassPreview', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ cookie: cookie }) });
            if (!r.ok) { notifyError(r.status === 401 ? 'A sessão do Hourglass expirou. Cole o pedido outra vez.' : (await r.text()) || 'Não foi possível obter os dados do Hourglass.'); return; }
            prev = await r.json(); desenhar();
        }, 'Não foi possível obter os dados do Hourglass.'));

        function desenhar() {
            const c = App.$('#syPasso2'); c.innerHTML = '';
            const upd = prev.linhas.filter(l => l.pubId > 0), novos = prev.linhas.filter(l => l.pubId === 0);
            c.innerHTML = '<p class="summary"><span><b class="num">' + upd.length + '</b> a atualizar</span><span>·</span><span><b class="num">' + novos.length + '</b> novos no Hourglass</span><span>·</span><span><b class="num">' + prev.semAlteracoes + '</b> já iguais</span><span>·</span><span><b class="num">' + prev.soLocal.length + '</b> só na aplicação</span></p>';
            c.insertAdjacentHTML('beforeend', '<div class="sy-bar"><span class="label">Selecionar</span><div class="chips is-choice" id="syChips" role="group" aria-label="Escolher o que atualizar">' +
                '<button type="button" class="chip" data-sy="tudo">Tudo</button><button type="button" class="chip" data-sy="nada">Nada</button>' +
                Object.keys(rotulo).map(k => '<button type="button" class="chip" data-sy-campo="' + k + '" aria-pressed="false">' + rotulo[k] + '</button>').join('') +
                '<button type="button" class="chip" data-sy-novos aria-pressed="false">Novos publicadores</button></div>' +
                '<p class="field-hint">«Tudo» marca também os dados que já estão preenchidos e são diferentes (substitui-os). Por omissão só se marca o que está vazio.</p></div>');
            upd.forEach((l, i) => {
                const el = document.createElement('section'); el.className = 'hg-semana'; el.dataset.id = l.hgId;
                el.innerHTML = '<header><label class="checkbox"><input type="checkbox" class="sy-on" checked> ' + esc(l.pubNome) + (l.hgNome !== l.pubNome ? ' <span class="field-hint">(Hourglass: ' + esc(l.hgNome) + ')</span>' : '') + '</label>' +
                    (l.cargo ? '<span class="tag is-light">' + esc(l.cargo) + '</span>' : '') + '</header><table><tbody></tbody></table>';
                const tb = App.$('tbody', el);
                l.campos.forEach((f, j) => {
                    const tr = document.createElement('tr'); tr.dataset.j = j; tr.dataset.campo = f.campo;
                    tr.innerHTML = '<td style="width:2rem"><input type="checkbox" class="sy-campo"' + (f.aplicar ? ' checked' : '') + ' aria-label="Aplicar ' + rotulo[f.campo] + '"></td><td>' + rotulo[f.campo] + '</td><td>' +
                        (f.atual ? esc(f.atual) : '<span class="field-hint">vazio</span>') + '</td><td><i class="fa-solid fa-arrow-right fa-xs"></i></td><td><b>' + esc(f.novo) + '</b></td>';
                    tb.appendChild(tr);
                });
                el.dataset.i = prev.linhas.indexOf(l); c.appendChild(el);
            });
            if (novos.length) {
                const el = document.createElement('section'); el.className = 'hg-semana';
                el.innerHTML = '<header><b>Novos no Hourglass</b><span class="field-hint">serão criados como «Publicador», sem palavra-passe (entram por passkey se o email coincidir)</span></header><table><tbody></tbody></table>';
                const tb = App.$('tbody', el);
                novos.forEach(l => {
                    const tr = document.createElement('tr'); tr.dataset.i = prev.linhas.indexOf(l);
                    tr.innerHTML = '<td style="width:2rem"><input type="checkbox" class="sy-novo" checked aria-label="Criar ' + esc(l.hgNome) + '"></td><td>' + esc(l.hgNome) + '</td><td>' + esc(l.email) + '</td><td>' + esc(l.telemovel) + '</td><td>' + esc(l.grupoNome) + '</td>';
                    tb.appendChild(tr);
                });
                c.appendChild(el);
            }
            if (prev.soLocal.length) {
                const d = document.createElement('details'); d.className = 'field-hint';
                d.innerHTML = '<summary>Só na aplicação (' + prev.soLocal.length + ')</summary><p>' + prev.soLocal.map(p => esc(p.nome)).join(' · ') + '</p>'; c.appendChild(d);
            }
            sincronizarChips();
            if (!upd.length && !novos.length) c.insertAdjacentHTML('beforeend', '<div class="empty-state"><strong>Tudo igual</strong>Não há dados novos para sincronizar.</div>');
            App.$('#syPasso1').hidden = true; c.hidden = false; App.$('#syObter').hidden = true; App.$('#syAplicar').hidden = !(upd.length || novos.length);
        }

        // Seleção em bloco: tudo, nada, ou só um tipo de dado (por exemplo só a morada ou só o grupo)
        const campos = campo => App.$$('#syPasso2 .sy-campo').filter(cb => !campo || cb.closest('tr').dataset.campo === campo);
        function marcarCabecalhos() { App.$$('#syPasso2 section[data-i]').forEach(el => { App.$('.sy-on', el).checked = App.$$('.sy-campo', el).some(cb => cb.checked); }); }
        function sincronizarChips() {
            App.$$('#syChips [data-sy-campo]').forEach(b => { const l = campos(b.dataset.syCampo); b.setAttribute('aria-pressed', l.length > 0 && l.every(cb => cb.checked)); b.disabled = l.length === 0; });
            const n = App.$$('#syPasso2 .sy-novo'); const b = App.$('#syChips [data-sy-novos]'); if (b) { b.setAttribute('aria-pressed', n.length > 0 && n.every(cb => cb.checked)); b.disabled = n.length === 0; }
        }
        document.addEventListener('click', e => {
            const b = e.target.closest('#syChips .chip'); if (!b) return;
            if (b.dataset.sy) { const on = b.dataset.sy === 'tudo'; campos().forEach(cb => cb.checked = on); App.$$('#syPasso2 .sy-novo').forEach(cb => cb.checked = on); }
            else if (b.dataset.syCampo) { const l = campos(b.dataset.syCampo), on = !l.every(cb => cb.checked); l.forEach(cb => cb.checked = on); }
            else if (b.hasAttribute('data-sy-novos')) { const l = App.$$('#syPasso2 .sy-novo'), on = !l.every(cb => cb.checked); l.forEach(cb => cb.checked = on); }
            marcarCabecalhos(); sincronizarChips();
        });
        document.addEventListener('change', e => {
            const h = e.target.closest('#syPasso2 .sy-on');
            if (h) App.$$('.sy-campo', h.closest('section')).forEach(cb => cb.checked = h.checked);
            if (e.target.closest('#syPasso2')) { marcarCabecalhos(); sincronizarChips(); }
        });

        App.on('syAplicar', async btn => {
            App.$$('#syPasso2 section[data-i]').forEach(el => {
                const l = prev.linhas[el.dataset.i];
                App.$$('tbody tr', el).forEach(tr => { l.campos[tr.dataset.j].aplicar = App.$('.sy-campo', tr).checked; });
                l.aplicar = l.campos.some(c => c.aplicar);   // a linha aplica-se se tiver algum campo marcado
            });
            App.$$('#syPasso2 .sy-novo').forEach(cb => { prev.linhas[cb.closest('tr').dataset.i].aplicar = cb.checked; });
            const n = prev.linhas.filter(l => l.aplicar).length; if (!n) { notifyError('Não há nada selecionado.'); return; }
            if (!await App.confirm({ title: 'Sincronizar publicadores', text: 'Aplicar as alterações selecionadas a ' + n + ' publicador(es)?', ok: 'Aplicar', danger: false })) return;
            App.run(btn, async () => {
                const r = await fetch('/Publicadores/HourglassAplicar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(prev) });
                if (!r.ok) throw new Error(await r.text());
                const x = await r.json(); notify(x.atualizados + ' atualizado(s) e ' + x.criados + ' criado(s).');
                setTimeout(() => location.reload(), 900);
            }, 'Não foi possível aplicar as alterações.');
        });
    })();
</script>
}
