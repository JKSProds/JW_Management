@model JW_Management.Models.Publicador
@inject IConfiguration Configuration
@inject JW_Management.Models.ConfigStore ConfigStore

@{
    ViewData["Title"] = "Iniciar sessão";
    ViewData["Bare"] = true;
    var soOidc = ConfigStore.SomenteOidcAtivo(Configuration);
    var temOidc = !string.IsNullOrEmpty(Configuration["Oidc:ClientId"]);
    var erro = !ViewData.ModelState.IsValid;
    var escolher = ViewBag.Escolher as IEnumerable<SelectListItem>;
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
}

<div class="auth-shell">
    <main class="auth-card" id="authCard">
        <div class="auth-logo">
            <span class="auth-mark"><img src="~/img/logo.png" alt=""></span>
            <h1>Gestor Congregacional</h1>
            <p>@(soOidc ? "Entre com a sua conta Pocket ID." : "Inicie sessão para continuar.")</p>
        </div>

        @if (erro)
        {
            <div class="notice is-bad" role="alert" id="divError">
                <span class="icon"><i class="fa-solid fa-circle-exclamation"></i></span>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        @if (!soOidc)
        {
            <form method="post" novalidate>
                @if (escolher != null)
                {
                    <div class="field">
                        <label class="label" for="selectTenant">Congregação</label>
                        <div class="select is-fullwidth">
                            <select id="selectTenant" name="t" required>
                                @foreach (var c in escolher) { <option value="@c.Value">@c.Text</option> }
                            </select>
                        </div>
                    </div>
                }
                <div class="field">
                    <label class="label" for="Username">Utilizador</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" asp-for="Username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                        <span class="icon is-left"><i class="fa-solid fa-user"></i></span>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="Password">Palavra-passe</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" asp-for="Password" autocomplete="current-password" required>
                        <span class="icon is-left"><i class="fa-solid fa-lock"></i></span>
                    </div>
                </div>
                <button class="button is-info is-fullwidth is-submit" type="submit" id="login-button">Iniciar sessão</button>
                <input type="hidden" name="ReturnUrl" value="@returnUrl">
            </form>
        }

        @if (temOidc)
        {
            @if (!soOidc) { <div class="auth-sep">ou</div> }
            <a class="button @(soOidc ? "is-info" : "is-info is-light") is-fullwidth is-submit" href="/login?returnUrl=@Uri.EscapeDataString(returnUrl ?? "/")">
                <span class="icon"><i class="fa-solid fa-fingerprint"></i></span><span>Entrar com Pocket ID</span>
            </a>
        }
    </main>
</div>

@section Scripts {
<script>
    if (document.getElementById('divError')) {
        document.getElementById('authCard').classList.add('is-shaking');
        if (navigator.vibrate) navigator.vibrate(200);
        const u = document.querySelector('[name=Username]'), pw = document.querySelector('[name=Password]'); (u && u.value ? pw : u).focus();
    }
</script>
}
