@using JW_Management.Models
@inject IConfiguration Configuration
@{
    var bare = ViewData["Bare"] as bool? == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Ativo(params string[] c) => c.Contains(ctrl) ? " is-active" : "";
    var autenticado = User.Identity!.IsAuthenticated;
    var nome = autenticado ? User.ObterNomeCompleto() : "";
    var iniciais = string.Concat((nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Where((_, i) => i == 0).Select(p => p[0])) +
                   string.Concat((nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Skip(1).LastOrDefault()?.Take(1) ?? "");
}
<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#17566b" />
    <title>@ViewData["Title"] - Gestor Congregacional @(autenticado ? $"({User.ObterCong()})" : "")</title>

    <link rel="preload" href="~/fonts/figtree-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css">
    <link rel="stylesheet" href="~/lib/bulma/css/bulma-no-dark-mode.css" />
    <link rel="stylesheet" href="~/lib/bulma-switch-control/css/main.min.css" />
    <link rel="stylesheet" href="~/lib/bulma-calendar/dist/css/bulma-calendar.min.css">
    <link rel="stylesheet" href="~/lib/bulma-responsive-tables/css/main.min.css" />
    <link rel="stylesheet" type="text/css" href="~/lib/bulma-list/css/bulma-list.css" />
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/bulma-pageloader/dist/css/bulma-pageloader.min.css" type="text/css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin=""/>
    <link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet"
          type="text/css" />
    @* Último, para vencer as folhas das bibliotecas *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="~/lib/vizuaalog/bulmajs/dist/bulma.min.js"></script>
    <script src="~/lib/bulma-calendar/dist/js/bulma-calendar.min.js"></script>
    <script src="~/lib/bulma-toast/dist/bulma-toast.min.js"></script>
    <script src="/lib/moment.js/moment-with-locales.min.js"></script>
    <script src="~/lib/dropzone/dropzone.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gantt-schedule-timeline-calendar"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
</head>
<body>
    @if (!bare)
    {
    <header class="app-nav">
        <nav class="navbar" role="navigation" aria-label="Navegação principal">
            <div class="navbar-brand">
                <a class="navbar-item" href="~/">
                    <img class="brand-mark" src="~/img/logo.png" alt="">
                    <span>Gestor Congregacional</span>
                </a>

                <a role="button" class="navbar-burger" aria-label="Abrir menu" aria-expanded="false"
                   data-target="menuPrincipal">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </a>
            </div>

            <div id="menuPrincipal" class="navbar-menu">
            @if (autenticado)
            {
                @if (User.ObterTenant() == 9999)
                {
                    <div class="navbar-start">
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link@(Ativo("Congressos"))">Congressos / Assembleias</a>
                            <div class="navbar-dropdown">
                                <a class="navbar-item" href="~/Congressos">
                                    <span class="icon"><i class="fa-solid fa-list"></i></span>
                                    <span>Lista</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="navbar-start">
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link@(Ativo("Literatura"))">
                                <span class="icon"><i class="fa-solid fa-book"></i></span>
                                <span>Literatura</span>
                            </a>
                            <div class="navbar-dropdown">
                                <a class="navbar-item" href="~/Literatura">
                                    <span class="icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                                    <span>Stock</span>
                                </a>
                                <a class="navbar-item" href="~/Literatura/Movimentos/1">
                                    <span class="icon"><i class="fa-solid fa-right-to-bracket"></i></span>
                                    <span>Entradas</span>
                                </a>
                                <a class="navbar-item" href="~/Literatura/Movimentos/2">
                                    <span class="icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                                    <span>Saídas</span>
                                </a>
                                <a class="navbar-item" href="~/Literatura/Pedidos">
                                    <span class="icon"><i class="fa-solid fa-book-medical"></i></span>
                                    <span>Pedidos</span>
                                </a>
                                <a class="navbar-item" href="~/Literatura/Periodicos">
                                    <span class="icon"><i class="fa-solid fa-newspaper"></i></span>
                                    <span>Periódicos a entregar</span>
                                </a>
                            </div>
                        </div>
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link@(Ativo("Territorios"))">
                                <span class="icon"><i class="fa-solid fa-map-location-dot"></i></span>
                                <span>Territórios</span>
                            </a>
                            <div class="navbar-dropdown">
                                <a class="navbar-item" href="~/Territorios">
                                    <span class="icon"><i class="fa-solid fa-list"></i></span>
                                    <span>Listagem</span>
                                </a>
                                <a class="navbar-item" href="~/Territorios/Registros">
                                    <span class="icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                                    <span>Registos</span>
                                </a>
                            </div>
                        </div>
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link@(Ativo("Reunioes"))">
                                <span class="icon"><i class="fa-solid fa-people-group"></i></span>
                                <span>Reuniões</span>
                            </a>
                            <div class="navbar-dropdown">
                                <a class="navbar-item" href="~/Reunioes">
                                    <span class="icon"><i class="fa-solid fa-list"></i></span>
                                    <span>Listagem</span>
                                </a>
                                <a class="navbar-item" href="~/Reunioes/Discursos">
                                    <span class="icon"><i class="fa-solid fa-person-chalkboard"></i></span>
                                    <span>Discursos</span>
                                </a>
                                <a class="navbar-item" href="~/Reunioes/Calendario">
                                    <span class="icon"><i class="fa-solid fa-calendar"></i></span>
                                    <span>Calendário</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
                <div class="navbar-end">
                    @if (autenticado)
                    {
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link">
                                <span class="user-chip">
                                    <span class="avatar" aria-hidden="true">@iniciais.ToUpper()</span>
                                    <span>@nome<small>@User.ObterCong()</small></span>
                                </span>
                            </a>

                            <div class="navbar-dropdown is-right">
                                <a class="navbar-item@(Ativo("Publicadores"))" href="~/Publicadores">
                                    <span class="icon"><i class="fa-solid fa-users"></i></span>
                                    <span>Publicadores</span>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="navbar-item@(Ativo("Configuracao"))" href="~/configuracao">
                                        <span class="icon"><i class="fa-solid fa-gear"></i></span>
                                        <span>Configuração</span>
                                    </a>
                                }
                                <a class="navbar-item" href="~/Home/Logout">
                                    <span class="icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
                                    <span>Terminar sessão</span>
                                </a>
                                <hr class="navbar-divider">
                                <div class="navbar-item nav-meta">
                                    <div>
                                        App v@(GetType().Assembly.GetName().Version)@(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development" ? " · DEV" : "")<br />
                                        BD v@(double.TryParse(Configuration["DbVersion"], out var dbv) ? dbv.ToString() : "N/D")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="navbar-item">
                            <a class="button is-info" href="~/Home/Login">
                                <span class="icon"><i class="fa-solid fa-right-to-bracket"></i></span>
                                <span>Iniciar sessão</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="app-main">
        @RenderBody()
    </main>
    <footer class="app-footer">Jorge Monteiro · v@(GetType().Assembly.GetName().Version)</footer>
    }
    else
    {
        @RenderBody()
    }
    @RenderSection("Scripts", required: false)
</body>

</html>
