@* Modal do leitor de QR; usar com App.qr(aoLer). *@
<div id="modalQr" class="modal" role="dialog" aria-modal="true" aria-labelledby="tQr">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tQr"><span class="icon"><i class="fa-solid fa-qrcode"></i></span><span>Leitura de código QR</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body"><div id="reader" style="width:100%"></div></section>
        <footer class="modal-card-foot"><button type="button" class="button" data-close>Fechar</button></footer>
    </div>
</div>
