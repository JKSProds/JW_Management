@* Lista de movimentos do dia, partilhada por Entradas e Saídas. É a região que App.refresh substitui ao mudar de data ou registar um movimento. *@
@model IEnumerable<JW_Management.Models.Movimentos>
@{
    var total = Model.Sum(m => Math.Abs(m.Quantidade));
}
<p class="summary"><span><b class="num">@Model.Count()</b> movimentos</span><span>·</span><span><b class="num">@total</b> unidades</span></p>
@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon"><i class="fa-regular fa-calendar-xmark"></i></span>
        <strong>Sem movimentos neste dia</strong>
        Escolha outra data ou registe um novo movimento.
    </div>
}
else
{
    <div class="items">
        @foreach (var item in Model)
        {
            <article class="item" data-stamp="@item.Stamp">
                <div class="thumb"><img src="@item.Literatura!.Imagem" alt="" loading="lazy" onerror="this.src='/img/l_no_photo.png'"></div>
                <div class="main">
                    <div class="name">@item.Literatura.Descricao</div>
                    <div class="meta">
                        <span class="ref-tag">@item.Literatura.Referencia</span>
                        @if (!string.IsNullOrWhiteSpace(item.Publicador?.Nome))
                        {
                            <span><i class="fa-solid fa-user fa-xs"></i> @item.Publicador.Nome</span>
                        }
                        <span class="num">@item.DataMovimento.ToString("HH:mm")</span>
                    </div>
                </div>
                <div class="side">
                    <div class="qty num @(item.In ? "is-in" : "is-out")">@(item.In ? "+" : "−")@Math.Abs(item.Quantidade)</div>
                    <div class="acts">
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagarMov" aria-label="Apagar movimento" title="Apagar movimento"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>
}
