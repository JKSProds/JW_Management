@model IEnumerable<JW_Management.Models.Movimentos>
@{
    ViewData["Title"] = "Literatura - Entradas";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div><h1>Entradas</h1></div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalEntrada">
                <span class="icon"><i class="fa-solid fa-book"></i></span><span>Publicações</span>
            </button>
            <button type="button" class="button is-info is-light" data-action="abrirPeriodicos">
                <span class="icon"><i class="fa-solid fa-newspaper"></i></span><span>Periódicos</span>
            </button>
        </div>
    </div>

    <partial name="_BarraData" />
    <div id="regiao"><partial name="_Movimentos" model="Model" /></div>
</div>

<div id="modalEntrada" class="modal" role="dialog" aria-modal="true" aria-labelledby="tEnt">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tEnt"><span class="icon"><i class="fa-solid fa-circle-plus"></i></span><span>Entrada de publicações</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtPub">Publicação</label>
                <div><input type="text" class="input" id="txtPub" placeholder="Escreva a referência ou o nome"></div>
                <input type="hidden" id="txtPubStamp" />
            </div>
            <div class="field">
                <label class="label" for="txtQtd">Quantidade</label>
                <partial name="_Stepper" model='("txtQtd", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="guardar" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

<div id="modalPeriodicos" class="modal" role="dialog" aria-modal="true" aria-labelledby="tPer">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tPer"><span class="icon"><i class="fa-solid fa-newspaper"></i></span><span>Entrada de periódicos</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="periodico">Publicação</label>
                <div class="control has-icons-left">
                    <div class="select is-fullwidth">
                        <select id="periodico" asp-items="@(new SelectList(ViewBag.Periodicos, "Value", "Text"))"></select>
                    </div>
                    <span class="icon is-left" id="iconSelect"><i class="fa-solid fa-newspaper"></i></span>
                </div>
            </div>
            <div class="field">
                <label class="label" for="ano">Ano</label>
                <div class="stepper">
                    <button type="button" data-action="anoMenos" aria-label="Ano anterior"><i class="fa-solid fa-minus"></i></button>
                    <input type="number" class="input" id="ano" value="@DateTime.Now.Year" readonly>
                    <button type="button" data-action="anoMais" aria-label="Ano seguinte"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtQtdPeriodico">Quantidade</label>
                <partial name="_Stepper" model='("txtQtdPeriodico", 1, 1)' />
            </div>
            <div id="divListaPeriodicos" class="items mt-4"></div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Fechar</button>
            <button type="button" class="button is-info" id="btnCriarPeriodico" data-action="guardarPeriodico" hidden><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<partial name="_ScriptMovimentos" />
<script>
    const modalEntrada = App.modal('modalEntrada'), modalPer = App.modal('modalPeriodicos');
    const pesq = App.pesquisaPublicacao('#txtPub', '#txtPubStamp', false);

    async function registarEntrada(stamp, qtd) {
        await App.api('POST', '/Literatura/Movimentos/', { stamp: stamp, qtd: qtd });
        await App.refresh('#regiao');
    }

    App.on('guardar', btn => App.run(btn, async () => {
        const stamp = App.$('#txtPubStamp').value, qtd = App.lerInt('#txtQtd');
        if (!stamp) return App.campo('#txtPub', 'Escolha uma publicação da lista de sugestões.');
        if (qtd < 1) return App.campo('#txtQtd', 'Indique uma quantidade positiva.');
        await registarEntrada(stamp, qtd);
        modalEntrada.close(); pesq.limpar(); App.$('#txtQtd').value = 1; notify('Entrada registada.');
    }, 'Não foi possível registar a entrada.'));

    // Cria (ou reutiliza) o periódico e regista a entrada.
    async function criarPeriodico(ref, desc, data, qtd) {
        const stamp = await App.api('POST', '/Literatura/Literatura/', { referencia: ref, descricao: desc, data: data, tipo: 7 });
        await registarEntrada(stamp, qtd);
    }

    App.on('abrirPeriodicos', () => { modalPer.open(); obterPeriodicos(); });
    App.on('anoMenos', () => { App.$('#ano').value = App.lerInt('#ano') - 1; obterPeriodicos(); });
    App.on('anoMais', () => { App.$('#ano').value = App.lerInt('#ano') + 1; obterPeriodicos(); });
    App.$('#periodico').addEventListener('change', obterPeriodicos);

    App.on('guardarPeriodico', btn => App.run(btn, async () => {
        const sel = App.$('#periodico'), ano = App.$('#ano').value;
        await criarPeriodico(sel.value, sel.options[sel.selectedIndex].text + ' - ' + ano, ano, App.lerInt('#txtQtdPeriodico'));
        notify('Periódico registado.');
    }, 'Não foi possível registar o periódico.'));

    let pedido = 0;
    async function obterPeriodicos() {
        const meu = ++pedido, lista = App.$('#divListaPeriodicos'), btnManual = App.$('#btnCriarPeriodico'), icon = App.$('#iconSelect');
        btnManual.hidden = true; lista.innerHTML = '<p class="field-hint">A obter periódicos…</p>';
        icon.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        try {
            const dados = await App.api('GET', '/Literatura/PesquisarPeriodicos/', { ano: App.$('#ano').value, tipo: App.$('#periodico').value });
            if (meu !== pedido) return;
            lista.innerHTML = '';
            if (!dados.length) {
                btnManual.hidden = false;
                lista.innerHTML = '<p class="field-hint">Não foi possível obter periódicos para este item. Pode ser um item anual: use «Guardar».</p>';
                return;
            }
            dados.forEach(o => {
                const el = document.createElement('article'); el.className = 'item';
                el.innerHTML = '<div class="thumb"><img alt="" loading="lazy"></div><div class="main"><div class="name"></div></div>' +
                    '<div class="side"><button type="button" class="button is-info"><span class="icon"><i class="fa-solid fa-plus"></i></span><span>Adicionar</span></button></div>';
                App.$('img', el).src = o.url; App.$('.name', el).textContent = o.descricao;
                App.$('button', el).addEventListener('click', e => App.run(e.currentTarget, async () => {
                    await criarPeriodico(o.referencia, o.descricao, o.data, App.lerInt('#txtQtdPeriodico')); notify('Periódico registado.');
                }, 'Não foi possível registar o periódico.'));
                lista.appendChild(el);
            });
        } catch (e) { if (meu === pedido) { lista.innerHTML = ''; notifyError('Não foi possível obter os periódicos.'); } }
        finally { if (meu === pedido) icon.innerHTML = '<i class="fa-solid fa-newspaper"></i>'; }
    }
</script>
}
