@model IEnumerable<JW_Management.Models.Literatura>
@{
    ViewData["Title"] = "Literatura";
    var tipos = ((IEnumerable<SelectListItem>)ViewBag.Tipos).ToList();
    var tipoAtual = (ViewData["tipo"] ?? 0).ToString();
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div>
                <h1>Stock de literatura</h1>
                
            </div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalNovaPublicacao">
                <span class="icon"><i class="fa-solid fa-plus"></i></span><span>Nova publicação</span>
            </button>
            <button type="button" class="button is-success" data-open="modalToken">
                <span class="icon"><i class="fa-solid fa-cloud-arrow-up"></i></span><span>Enviar JW Hub</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-book", "Publicações", Model.Count().ToString(), "sPub", ""),
        ("fa-boxes-stacked", "Unidades em stock", Model.Sum(l => l.Quantidade).ToString(), "sUn", "is-ok"),
        ("fa-triangle-exclamation", "Sem stock", Model.Count(l => l.Quantidade <= 0).ToString(), "sZero", "is-bad") })

    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar por referência ou descrição" value="@ViewData["filtro"]" aria-label="Pesquisar publicações">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar por tipo">
            @foreach (var t in tipos)
            {
                <button type="button" class="chip" data-type="@t.Value" aria-pressed="@((t.Value == tipoAtual).ToString().ToLower())">@t.Text</button>
            }
        </div>
    </div>

    <div id="lista" class="items">
        @foreach (var item in Model)
        {
            <article class="item" data-stamp="@item.Stamp" data-type="@item.Tipo!.Id" data-qty="@item.Quantidade" data-search="@item.Referencia @item.Descricao @item.Tipo.Descricao">
                <div class="thumb"><img src="@item.Imagem" alt="" loading="lazy" onerror="this.remove()"></div>
                <div class="main">
                    <div class="name">@item.Descricao</div>
                    <div class="meta">
                        <span class="ref-tag">@item.Referencia</span>
                        <span>@item.Tipo.Descricao</span>
                    </div>
                </div>
                <div class="side">
                    <div class="qty num @(item.Quantidade <= 0 ? "is-low" : "")"><span data-qty>@item.Quantidade</span><small>em stock</small><span class="qbar" aria-hidden="true"><i></i></span></div>
                    <div class="acts">
                        <button type="button" class="button btn-icon" data-action="imagem" aria-label="Alterar imagem" title="Alterar imagem"><i class="fa-solid fa-image"></i></button>
                        <button type="button" class="button btn-icon" data-action="quantidade" aria-label="Acertar quantidade" title="Acertar quantidade"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>

    <div id="vazio" class="empty-state" hidden>
        <span class="icon"><i class="fa-solid fa-book-open"></i></span>
        <strong>Não foram encontradas publicações</strong>
        Experimente outra pesquisa ou adicione uma nova publicação.
    </div>
</div>

<div id="modalNovaPublicacao" class="modal" role="dialog" aria-modal="true" aria-labelledby="tNova">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tNova"><span class="icon"><i class="fa-solid fa-circle-plus"></i></span><span>Nova publicação</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtRefPub">Referência</label>
                <input type="text" class="input" id="txtRefPub" placeholder="ex.: lff">
            </div>
            <div class="field">
                <label class="label" for="txtNomePub">Nome</label>
                <input type="text" class="input" id="txtNomePub">
            </div>
            <div class="field">
                <label class="label" for="txtTipoPub">Tipo</label>
                <div class="select is-fullwidth">
                    <select id="txtTipoPub" asp-items="@(new SelectList(tipos, "Value", "Text"))"></select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtQtdPub">Quantidade inicial</label>
                <partial name="_Stepper" model='("txtQtdPub", 1, 0)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criar" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Criar</span></button>
        </footer>
    </div>
</div>

<div id="modalQuantidade" class="modal" role="dialog" aria-modal="true" aria-labelledby="tQtd">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tQtd"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span><span>Acertar quantidade</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4" id="qtdNome"></p>
            <div class="field">
                <label class="label" for="txtQtd">Quantidade em stock</label>
                <partial name="_Stepper" model='("txtQtd", 0, 0)' />
                <p class="field-hint">É criado um movimento com a diferença para o stock atual.</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="guardarQtd" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

<div id="modalImagem" class="modal" role="dialog" aria-modal="true" aria-labelledby="tImg">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tImg"><span class="icon"><i class="fa-solid fa-image"></i></span><span>Imagem da publicação</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <form action="/Literatura/Imagem" method="POST" class="dropzone" id="frmImagem">
                <input type="hidden" name="id" id="txtStampImagem">
                <div class="dz-message needsclick">Largue aqui a imagem ou toque para escolher</div>
            </form>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button is-info" data-close>Fechar</button>
        </footer>
    </div>
</div>

<div id="modalToken" class="modal" role="dialog" aria-modal="true" aria-labelledby="tTok">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tTok"><span class="icon"><i class="fa-solid fa-cloud-arrow-up"></i></span><span>Enviar inventário para o JW Hub</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="notice is-warn">
                <span class="icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                <span>Requer conhecimentos técnicos. Abra a página da literatura no JW Hub, prima F12, e no separador Rede procure o pedido «OVERVIEW». Copie o valor de «Cookie» na íntegra e cole-o abaixo.</span>
            </div>
            <div class="field">
                <label class="label" for="txtCookie">Cookie de sessão</label>
                <input type="password" class="input" id="txtCookie" placeholder="Cole aqui a cookie" autocomplete="off">
                <p class="field-hint">O valor não é guardado; só é usado neste envio.</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-success" data-action="enviarHub" data-submit><span class="icon"><i class="fa-regular fa-paper-plane"></i></span><span>Enviar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    const modalNova = App.modal('modalNovaPublicacao'), modalQtd = App.modal('modalQuantidade'),
          modalImg = App.modal('modalImagem'), modalTok = App.modal('modalToken');
    let atual = null, imagemAlterada = false;

    // A barra de estatísticas segue o filtro e as alterações de quantidade.
    // Barra de stock relativa ao maior stock da lista: vermelha vazia a 0, âmbar até 20% do maior.
    function barras() {
        const todos = App.$$('#lista .item'), max = Math.max(1, ...todos.map(i => +i.dataset.qty));
        todos.forEach(i => {
            const q = +i.dataset.qty, b = App.$('.qbar', i);
            App.$('i', b).style.width = Math.min(100, Math.max(0, q / max * 100)) + '%';
            b.classList.toggle('is-zero', q <= 0); b.classList.toggle('is-warn', q > 0 && q <= max * .2);
        });
    }
    const estat = visiveis => { barras(); App.stats({
        sPub: visiveis.length,
        sUn: visiveis.reduce((s, i) => s + (+i.dataset.qty), 0),
        sZero: visiveis.filter(i => +i.dataset.qty <= 0).length
    }); };
    const filtroLista = App.filtro({ lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio', tipo: '@tipoAtual', aoAplicar: estat });

    const itemDe = el => el.closest('.item');

    App.on('quantidade', btn => {
        atual = itemDe(btn);
        App.$('#qtdNome').textContent = '[' + App.$('.ref-tag', atual).textContent + '] ' + App.$('.name', atual).textContent;
        App.$('#txtQtd').value = App.$('[data-qty]', atual).textContent;
        modalQtd.open();
    });

    App.on('guardarQtd', btn => App.run(btn, async () => {
        const stamp = atual.dataset.stamp, nova = App.lerInt('#txtQtd');
        const res = await App.api('GET', '/Literatura/Literatura/', { id: stamp });
        const diff = nova - (+res.quantidade);
        if (diff !== 0) await App.api('POST', '/Literatura/Movimentos/', { stamp: stamp, qtd: diff });
        atual.dataset.qty = nova; filtroLista.aplicar();
        const q = App.$('[data-qty]', atual); q.textContent = nova;
        q.closest('.qty').classList.toggle('is-low', nova <= 0);
        modalQtd.close(); notify('Quantidade atualizada.');
    }, 'Não foi possível atualizar a quantidade.'));

    App.on('apagar', async btn => {
        const it = itemDe(btn);
        if (!await App.confirm({ title: 'Apagar publicação', text: 'Apagar «' + App.$('.name', it).textContent + '» e todos os movimentos associados?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Literatura/Literatura/', { stamp: it.dataset.stamp }); App.removeItem(it); notify('Publicação apagada.'); },
            'Não foi possível apagar a publicação.');
    });

    App.on('imagem', btn => {
        atual = itemDe(btn); imagemAlterada = false;
        App.$('#txtStampImagem').value = atual.dataset.stamp;
        Dropzone.forElement('#frmImagem').removeAllFiles(true);
        modalImg.open();
    });
    // A imagem nova só aparece depois de o servidor a registar: atualiza a lista ao fechar, sem recarregar a página.
    // O Dropzone só inicializa o formulário em DOMContentLoaded (registado antes, no <head>).
    document.addEventListener('DOMContentLoaded', () =>
        Dropzone.forElement('#frmImagem').on('success', () => { imagemAlterada = true; notify('Imagem guardada.'); }));
    modalImg.el.addEventListener('closed', () => { if (imagemAlterada) App.refresh('#lista'); });

    App.on('criar', btn => App.run(btn, async () => {
        const ref = App.$('#txtRefPub').value.trim(), nome = App.$('#txtNomePub').value.trim();
        if (!ref) return App.campo('#txtRefPub', 'Indique a referência.');
        if (!nome) return App.campo('#txtNomePub', 'Indique o nome da publicação.');
        const stamp = await App.api('POST', '/Literatura/Literatura/', { referencia: ref, descricao: nome, data: '', tipo: App.$('#txtTipoPub').value });
        const qtd = App.lerInt('#txtQtdPub');
        if (qtd !== 0) await App.api('POST', '/Literatura/Movimentos/', { stamp: stamp, qtd: qtd });
        modalNova.close(); await App.refresh('#lista'); notify('Publicação criada.');
        App.$$('#modalNovaPublicacao input[type=text]').forEach(i => i.value = '');
    }, 'Não foi possível criar a publicação.'));

    App.on('enviarHub', btn => App.run(btn, async () => {
        const c = App.$('#txtCookie').value.trim(); if (!c) return App.campo('#txtCookie', 'Cole a cookie primeiro.');
        await App.api('GET', '/Literatura/API/', { id: c });
        App.$('#txtCookie').value = ''; modalTok.close(); notify('Inventário enviado com sucesso.');
    }, 'Não foi possível enviar. O inventário deste mês pode já ter sido enviado, a cookie estar errada ou sem acesso à literatura da congregação.'));
</script>
}
