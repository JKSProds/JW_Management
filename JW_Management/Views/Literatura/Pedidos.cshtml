@model IEnumerable<JW_Management.Models.Literatura>
@{
    ViewData["Title"] = "Literatura - Pedidos";
    var periodicos = Model.Where(l => l.Tipo!.Id == 7).ToList();
    var especiais = Model.Where(l => l.Tipo!.Id != 7).ToList();
    var estados = ((IEnumerable<SelectListItem>)ViewBag.Estados).ToList();
    var iconesEstado = new[] { "clock", "envelope", "truck-fast", "check-double" };
    var publicadores = ((IEnumerable<SelectListItem>)ViewBag.Publicadores).ToList();
    var pendentes = especiais.Count(l => l.EstadoPedido!.Descricao == "Pendente");
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Pedidos</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalPedidoEspecial">
                <span class="icon"><i class="fa-solid fa-book"></i></span><span>Pedir publicação</span>
            </button>
            <button type="button" class="button is-info is-light" data-open="modalPedidoPeriodico">
                <span class="icon"><i class="fa-solid fa-newspaper"></i></span><span>Pedir periódico</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-newspaper", "Pedidos de periódicos", periodicos.Count.ToString(), "pPer", ""),
        ("fa-copy", "Exemplares pedidos", periodicos.Sum(l => l.Quantidade).ToString(), "pEx", ""),
        ("fa-book", "Pedidos especiais", especiais.Count.ToString(), "pEsp", ""),
        ("fa-clock", "Especiais por enviar", pendentes.ToString(), "pPend", pendentes > 0 ? "is-warn" : "is-ok") })

    <div class="seg" role="tablist" aria-label="Tipo de pedido">
        <button type="button" role="tab" id="tabPer" aria-controls="panPer" aria-selected="true">Periódicos<span class="count" id="cPer">@periodicos.Count</span></button>
        <button type="button" role="tab" id="tabEsp" aria-controls="panEsp" aria-selected="false">Especiais<span class="count" id="cEsp">@especiais.Count</span></button>
    </div>

    <section id="panPer" role="tabpanel" aria-labelledby="tabPer" data-painel="per">
        <div class="toolbar">
            <div class="control has-icons-left search">
                <input type="search" class="input" id="fPer" placeholder="Pesquisar por publicador ou publicação" aria-label="Pesquisar pedidos de periódicos">
                <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
            </div>
            <div class="select">
                <select id="filtrop" aria-label="Filtrar pela publicação">
                    <option value="0">Todas as publicações</option>
                    @foreach (var p in (IEnumerable<SelectListItem>)ViewBag.Periodicos) { <option value="@p.Value">@p.Text</option> }
                </select>
            </div>
            <button type="button" class="button is-success" data-open="modalMailPeriodicos">
                <span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar pedidos</span>
            </button>
        </div>
        <div class="list-tools">
            <label class="check-all"><input type="checkbox" id="todosPer"> <span>Selecionar visíveis</span></label>
            <div class="chips is-choice" id="modoPer" role="group" aria-label="Agrupar por">
                <span class="field-hint">Agrupar por</span>
                <button type="button" class="chip" data-modo="publicacao" aria-pressed="true">Publicação</button>
                <button type="button" class="chip" data-modo="publicador" aria-pressed="false">Publicador</button>
            </div>
        </div>
        <div id="listaPer" class="items">
            @foreach (var item in periodicos)
            {
                <article class="item has-sel" data-stamp="@item.Stamp" data-ref="@item.Referencia" data-desc="@item.Descricao" data-pub="@item.Publicador!.Nome" data-qtd="@item.Quantidade"
                         data-search="@item.Referencia @item.Descricao @item.Publicador.Nome">
                    <label class="sel"><input type="checkbox" class="sel-cb" aria-label="Selecionar pedido de @item.Publicador.Nome"></label>
                    <div class="thumb"><img src="@item.Imagem" alt="" loading="lazy" onerror="this.remove()"></div>
                    <div class="main">
                        <div class="name">@item.Descricao</div>
                        <div class="meta">
                            <span class="ref-tag">@item.Referencia</span>
                            <span><i class="fa-solid fa-user fa-xs"></i> @item.Publicador.Nome</span>
                        </div>
                    </div>
                    <div class="side">
                        <div class="qty num"><span>@item.Quantidade</span><small>exemplares</small></div>
                        <div class="acts">
                            <button type="button" class="button btn-icon is-danger-hover" data-action="apagarUm" aria-label="Apagar pedido" title="Apagar pedido"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                </article>
            }
        </div>
        <div id="vazioPer" class="empty-state" hidden><span class="icon"><i class="fa-regular fa-newspaper"></i></span><strong>Sem pedidos de periódicos</strong>Não há resultados. Use «Pedir periódico» para registar um pedido.</div>
    </section>

    <section id="panEsp" role="tabpanel" aria-labelledby="tabEsp" data-painel="esp" hidden>
        <div class="toolbar">
            <div class="control has-icons-left search">
                <input type="search" class="input" id="fEsp" placeholder="Pesquisar por publicador ou publicação" aria-label="Pesquisar pedidos especiais">
                <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
            </div>
            <button type="button" class="button is-success" data-open="modalMailPedidos">
                <span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar pedidos novos</span>
            </button>
            <div class="chips" id="chipsEsp" role="group" aria-label="Filtrar por estado">
                <button type="button" class="chip" data-estado="0" aria-pressed="true">Todos <span class="num" data-n="0"></span></button>
                @foreach (var e in estados)
                {
                    <button type="button" class="chip" data-estado="@e.Value" aria-pressed="false">@e.Text <span class="num" data-n="@e.Value"></span></button>
                }
            </div>
        </div>
        <div class="list-tools">
            <label class="check-all"><input type="checkbox" id="todosEsp"> <span>Selecionar visíveis</span></label>
            <div class="chips is-choice" id="modoEsp" role="group" aria-label="Agrupar por">
                <span class="field-hint">Agrupar por</span>
                <button type="button" class="chip" data-modo="publicador" aria-pressed="true">Publicador</button>
                <button type="button" class="chip" data-modo="publicacao" aria-pressed="false">Publicação</button>
            </div>
        </div>
        <div id="listaEsp" class="items">
            @foreach (var item in especiais)
            {
                var estado = item.EstadoPedido!.Descricao ?? "";
                <article class="item has-sel" data-stamp="@item.Stamp" data-ref="@item.Referencia" data-desc="@item.Descricao" data-pub="@item.Publicador!.Nome" data-qtd="@item.Quantidade" data-estado="@estado"
                         data-search="@item.Referencia @item.Descricao @item.Publicador.Nome @estado">
                    <label class="sel"><input type="checkbox" class="sel-cb" aria-label="Selecionar pedido de @item.Publicador.Nome"></label>
                    <div class="thumb"><img src="@item.Imagem" alt="" loading="lazy" onerror="this.remove()"></div>
                    <div class="main">
                        <div class="name">@item.Descricao</div>
                        <div class="meta">
                            <span class="ref-tag">@item.Referencia</span>
                            <span><i class="fa-solid fa-user fa-xs"></i> @item.Publicador.Nome</span>
                            <span class="tag estado-tag estado-@(estado.Split(' ')[0])">@estado</span>
                        </div>
                    </div>
                    <div class="side">
                        <div class="qty num"><span>@item.Quantidade</span><small>unidades</small></div>
                        <div class="acts">
                            <button type="button" class="button is-info is-light" data-action="avancar"><span class="icon"><i class="fa-solid fa-forward-step"></i></span><span class="avancar-txt">Avançar</span></button>
                            <button type="button" class="button btn-icon" data-action="editarEsp" aria-label="Editar pedido" title="Editar estado e quantidade"><i class="fa-solid fa-pen"></i></button>
                            <button type="button" class="button btn-icon is-danger-hover" data-action="apagarUm" aria-label="Apagar pedido" title="Apagar pedido"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                </article>
            }
        </div>
        <div id="vazioEsp" class="empty-state" hidden><span class="icon"><i class="fa-solid fa-book"></i></span><strong>Sem pedidos especiais</strong>Não há resultados. Use «Pedir publicação» para registar um pedido.</div>
    </section>
</div>

<div id="bulkbar" class="bulkbar" role="region" aria-label="Ações sobre os pedidos selecionados" hidden>
    <span class="bulk-n"><b class="num" id="bulkN">0</b> selecionado(s)</span>
    <div class="chips is-choice" id="bulkEstados" aria-label="Marcar como">
        @for (var i = 0; i < estados.Count; i++)
        {
            <button type="button" class="chip" data-bulk-estado="@estados[i].Value"><i class="fa-solid fa-@(iconesEstado[Math.Min(i, iconesEstado.Length - 1)]) mr-1"></i>@estados[i].Text</button>
        }
    </div>
    <button type="button" class="button is-danger is-light" data-action="apagarSel"><span class="icon"><i class="fa-solid fa-trash-can"></i></span><span>Apagar</span></button>
    <button type="button" class="button is-ghost" data-action="limparSel">Limpar seleção</button>
</div>

<div id="modalPedidoEspecial" class="modal" role="dialog" aria-modal="true" aria-labelledby="tPE">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tPE"><span class="icon"><i class="fa-solid fa-box-open"></i></span><span>Pedir publicação</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtIdPublicador">Publicador</label>
                <div class="select is-fullwidth">
                    <select id="txtIdPublicador">
                        <option value="" disabled selected>Escolha o publicador…</option>
                        <option value="0">Loja (sem publicador)</option>
                        @foreach (var p in publicadores) { <option value="@p.Value">@p.Text</option> }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtPub">Publicação</label>
                <div><input type="text" class="input" id="txtPub" placeholder="Escreva a referência ou o nome"></div>
                <input type="hidden" id="txtPubStamp" />
            </div>
            <div class="field">
                <label class="label" for="txtQtd">Quantidade</label>
                <partial name="_Stepper" model='("txtQtd", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criarEsp" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

<div id="modalPedidoPeriodico" class="modal" role="dialog" aria-modal="true" aria-labelledby="tPP">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tPP"><span class="icon"><i class="fa-solid fa-box-open"></i></span><span>Pedir periódico</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtIdPublicador2">Publicador</label>
                <div class="select is-fullwidth">
                    <select id="txtIdPublicador2">
                        <option value="" disabled selected>Escolha o publicador…</option>
                        @foreach (var p in publicadores) { <option value="@p.Value">@p.Text</option> }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="periodico">Publicação</label>
                <div class="select is-fullwidth">
                    <select id="periodico" asp-items="@(new SelectList(ViewBag.Periodicos, "Value", "Text"))"></select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtQtdPeriodico">Quantidade</label>
                <partial name="_Stepper" model='("txtQtdPeriodico", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criarPer" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

<div id="modalEstado" class="modal" role="dialog" aria-modal="true" aria-labelledby="tEst">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tEst"><span class="icon"><i class="fa-solid fa-pen"></i></span><span>Atualizar pedido</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4" id="estNome"></p>
            <div class="field">
                <span class="label">Estado</span>
                <div class="chips is-choice" id="chipsEstado" role="group" aria-label="Estado do pedido">
                    @for (var i = 0; i < estados.Count; i++)
                    {
                        <button type="button" class="chip" data-estado="@estados[i].Value" aria-pressed="false">
                            <i class="fa-solid fa-@(iconesEstado[Math.Min(i, iconesEstado.Length - 1)]) mr-1"></i>@estados[i].Text
                        </button>
                    }
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtQtdPedido">Quantidade</label>
                <partial name="_Stepper" model='("txtQtdPedido", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="guardarEstado" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

<div id="modalMailPedidos" class="modal" role="dialog" aria-modal="true" aria-labelledby="tMP">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tMP"><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar pedidos especiais</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4">Os pedidos <strong>pendentes</strong> serão enviados por email e passam ao estado «Enviado Email».</p>
            <div class="field">
                <label class="label" for="txtEmailPedidos">Email de destino</label>
                <input type="email" class="input" id="txtEmailPedidos" data-email autocomplete="email">
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="enviarEsp" data-submit><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar</span></button>
        </footer>
    </div>
</div>

<div id="modalMailPeriodicos" class="modal" role="dialog" aria-modal="true" aria-labelledby="tMPer">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tMPer"><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar pedidos de periódicos</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="mailperiodico">Publicação</label>
                <div class="select is-fullwidth">
                    <select id="mailperiodico">
                        <option value="0">Todas</option>
                        @foreach (var p in (IEnumerable<SelectListItem>)ViewBag.Periodicos) { <option value="@p.Value">@p.Text</option> }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtEmailPeriodicos">Email de destino</label>
                <input type="email" class="input" id="txtEmailPeriodicos" data-email autocomplete="email">
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="enviarPer" data-submit><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    const M = id => App.modal(id);
    const pesq = App.pesquisaPublicacao('#txtPub', '#txtPubStamp', false);
    const estados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(estados.Select(e => e.Value)));
    const P = {
        per: { sec: '#panPer', lista: '#listaPer', q: '#fPer', vazio: '#vazioPer', todos: '#todosPer', modo: '#modoPer' },
        esp: { sec: '#panEsp', lista: '#listaEsp', q: '#fEsp', vazio: '#vazioEsp', todos: '#todosEsp', modo: '#modoEsp', chips: '#chipsEsp' }
    };
    const norm = t => (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const itens = k => App.$$('.item', App.$(P[k].lista));
    const ativo = () => App.$('#tabPer').getAttribute('aria-selected') === 'true' ? 'per' : 'esp';
    let atual = null, estadoSel = null;
    const modo = { per: lembrado('per', 'publicacao'), esp: lembrado('esp', 'publicador') };

    function lembrado(k, padrao) { try { return localStorage.getItem('pedidosModo_' + k) || padrao; } catch (e) { return padrao; } }

    // Lembra o último email usado neste dispositivo (conveniência; falha em silêncio).
    const guardarEmail = v => { try { localStorage.setItem('emailPedidos', v); } catch (e) { } };
    try { const e = localStorage.getItem('emailPedidos'); if (e) App.$$('[data-email]').forEach(i => i.value = e); } catch (e) { }

    // ---------- Agrupar, filtrar e contar ----------
    function agrupar(k) {
        const lista = App.$(P[k].lista); App.$$('.group-title', lista).forEach(h => h.remove());
        const chave = i => modo[k] === 'publicador' ? i.dataset.pub : (i.dataset.desc + ' · ' + i.dataset.ref);
        const todos = itens(k).sort((a, b) => chave(a).localeCompare(chave(b), 'pt') || a.dataset.pub.localeCompare(b.dataset.pub, 'pt'));
        let ultima = null;
        todos.forEach(i => {
            if (chave(i) !== ultima) {
                ultima = chave(i);
                const h = document.createElement('h3'); h.className = 'group-title';
                h.innerHTML = '<label class="check-group"><input type="checkbox" class="grp-cb" aria-label="Selecionar o grupo"> <span></span> <span class="count"></span></label>';
                App.$('span', h).textContent = ultima; lista.appendChild(h);
            }
            lista.appendChild(i);
        });
        App.$$('[data-modo]', App.$(P[k].modo)).forEach(b => b.setAttribute('aria-pressed', b.dataset.modo === modo[k]));
    }

    function aplicar(k) {
        const p = P[k], q = norm(App.$(p.q).value.trim());
        const ref = k === 'per' ? App.$('#filtrop').value : '0';
        const est = k === 'esp' ? (App.$('[aria-pressed=true]', App.$(p.chips)) || {}).dataset?.estado || '0' : '0';
        let n = 0;
        itens(k).forEach(i => {
            const ok = (!q || norm(i.dataset.search).includes(q)) && (k === 'per' ? (ref === '0' || i.dataset.ref === ref) : (est === '0' || i.dataset.estado === est));
            i.classList.toggle('is-hidden', !ok); if (ok) n++;
        });
        // cabeçalhos de grupo: só aparecem com itens visíveis e mostram quantos
        const lista = App.$(p.lista); let cab = null, cont = 0;
        const fecha = () => { if (cab) { cab.classList.toggle('is-hidden', cont === 0); App.$('.count', cab).textContent = cont; } };
        Array.from(lista.children).forEach(el => {
            if (el.classList.contains('group-title')) { fecha(); cab = el; cont = 0; }
            else if (!el.classList.contains('is-hidden')) cont++;
        }); fecha();
        App.$(p.vazio).hidden = n > 0;
        if (k === 'esp') {
            App.$$('[data-n]', App.$(p.chips)).forEach(s => { const e = s.dataset.n; s.textContent = itens('esp').filter(i => e === '0' || i.dataset.estado === e).length; });
        }
        sincronizarSel();
    }

    function estatisticas() {
        const per = itens('per'), esp = itens('esp');
        App.stats({ pPer: per.length, pEx: per.reduce((s, i) => s + (+i.dataset.qtd), 0), pEsp: esp.length, pPend: esp.filter(i => i.dataset.estado === 'Pendente').length });
        App.$('#cPer').textContent = per.length; App.$('#cEsp').textContent = esp.length;
        esp.forEach(i => { // texto e destino do botão «Avançar» de cada pedido
            const pos = estados.indexOf(i.dataset.estado), b = App.$('[data-action=avancar]', i); if (!b) return;
            const seguinte = estados[pos + 1]; b.disabled = !seguinte;
            App.$('.avancar-txt', b).textContent = seguinte ? seguinte : 'Concluído'; b.title = seguinte ? 'Avançar para «' + seguinte + '»' : 'Já está no último estado';
        });
    }

    function tudo() { ['per', 'esp'].forEach(k => { agrupar(k); aplicar(k); }); estatisticas(); }
    ['per', 'esp'].forEach(k => {
        App.$(P[k].q).addEventListener('input', () => aplicar(k));
        App.$(P[k].modo).addEventListener('click', e => { const b = e.target.closest('[data-modo]'); if (!b) return; modo[k] = b.dataset.modo; try { localStorage.setItem('pedidosModo_' + k, modo[k]); } catch (x) { } agrupar(k); aplicar(k); });
    });
    App.$('#filtrop').addEventListener('change', () => aplicar('per'));
    App.$(P.esp.chips).addEventListener('click', e => { const c = e.target.closest('.chip'); if (!c) return; App.$$('.chip', App.$(P.esp.chips)).forEach(x => x.setAttribute('aria-pressed', x === c)); aplicar('esp'); });

    // ---------- Seleção em bloco ----------
    const selecionados = k => itens(k).filter(i => App.$('.sel-cb', i).checked);
    function sincronizarSel() {
        const k = ativo(), sel = selecionados(k), vis = itens(k).filter(i => !i.classList.contains('is-hidden'));
        const todos = App.$(P[k].todos); todos.checked = vis.length > 0 && vis.every(i => App.$('.sel-cb', i).checked); todos.indeterminate = !todos.checked && vis.some(i => App.$('.sel-cb', i).checked);
        itens(k).forEach(i => i.classList.toggle('is-selected', App.$('.sel-cb', i).checked));
        const lista = App.$(P[k].lista);
        App.$$('.group-title', lista).forEach(h => { // caixa do grupo reflete os itens visíveis dele
            const doGrupo = []; for (let el = h.nextElementSibling; el && !el.classList.contains('group-title'); el = el.nextElementSibling) if (!el.classList.contains('is-hidden')) doGrupo.push(el);
            const cb = App.$('.grp-cb', h); cb.checked = doGrupo.length > 0 && doGrupo.every(i => App.$('.sel-cb', i).checked);
        });
        App.$('#bulkN').textContent = sel.length; App.$('#bulkbar').hidden = sel.length === 0;
        App.$('#bulkEstados').hidden = k !== 'esp';
    }
    document.addEventListener('change', e => {
        const k = ativo();
        if (e.target.matches('.sel-cb')) sincronizarSel();
        else if (e.target.id === 'todosPer' || e.target.id === 'todosEsp') { itens(k).filter(i => !i.classList.contains('is-hidden')).forEach(i => App.$('.sel-cb', i).checked = e.target.checked); sincronizarSel(); }
        else if (e.target.matches('.grp-cb')) {
            for (let el = e.target.closest('.group-title').nextElementSibling; el && !el.classList.contains('group-title'); el = el.nextElementSibling) if (!el.classList.contains('is-hidden')) App.$('.sel-cb', el).checked = e.target.checked;
            sincronizarSel();
        }
    });
    document.addEventListener('click', e => { if (e.target.closest('.seg [role=tab]')) setTimeout(() => { limpar(); sincronizarSel(); }, 0); });
    const limpar = () => ['per', 'esp'].forEach(k => itens(k).forEach(i => App.$('.sel-cb', i).checked = false));
    App.on('limparSel', () => { limpar(); sincronizarSel(); });

    async function recarregar() {
        const r = await fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
        const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
        ['#listaPer', '#listaEsp'].forEach(s => { App.$(s).innerHTML = App.$(s, doc).innerHTML; });
        tudo();
    }

    // Estado de vários pedidos de uma vez
    document.addEventListener('click', async e => {
        const b = e.target.closest('[data-bulk-estado]'); if (!b) return;
        const sel = selecionados('esp'); if (!sel.length) return;
        App.run(b, async () => {
            await App.api('PUT', '/Literatura/PedidoEstado/', { stamps: sel.map(i => i.dataset.stamp).join(','), estado: b.dataset.bulkEstado });
            sel.forEach(i => mudarEstado(i, b.dataset.bulkEstado)); limpar(); aplicar('esp'); estatisticas();
            notify(sel.length + ' pedido(s) marcado(s) como «' + b.dataset.bulkEstado + '».');
        }, 'Não foi possível atualizar os pedidos.');
    });
    function mudarEstado(i, est) {
        i.dataset.estado = est; i.dataset.search = i.dataset.search.replace(/(Pendente|Enviado Email|Enviado|Fornecido)\s*$/, '') + ' ' + est;
        const t = App.$('.estado-tag', i); t.textContent = est; t.className = 'tag estado-tag estado-' + est.split(' ')[0];
    }

    App.on('apagarSel', async btn => {
        const k = ativo(), sel = selecionados(k); if (!sel.length) return;
        if (!await App.confirm({ title: 'Apagar pedidos', text: 'Apagar ' + sel.length + ' pedido(s) selecionado(s)? Esta ação é irreversível.', ok: 'Apagar' })) return;
        App.run(btn, async () => {
            await App.api('DELETE', '/Literatura/PedidosApagar/', { ids: sel.map(i => i.dataset.stamp).join(','), tipo: k === 'per' ? 'periodico' : 'especial' });
            sel.forEach(i => i.remove()); aplicar(k); estatisticas(); notify(sel.length + ' pedido(s) apagado(s).');
        }, 'Não foi possível apagar os pedidos.');
    });

    // Um pedido de cada vez
    App.on('apagarUm', async btn => {
        const it = btn.closest('.item'), k = ativo();
        if (!await App.confirm({ title: 'Apagar pedido', text: 'Apagar o pedido de «' + it.dataset.pub + '» (' + it.dataset.desc + ')?', ok: 'Apagar' })) return;
        App.run(btn, async () => {
            await App.api('DELETE', k === 'per' ? '/Literatura/Periodico/' : '/Literatura/Pedido/', { id: it.dataset.stamp });
            it.remove(); aplicar(k); estatisticas(); notify('Pedido apagado.');
        }, 'Não foi possível apagar o pedido.');
    });

    App.on('avancar', btn => {
        const it = btn.closest('.item'), seguinte = estados[estados.indexOf(it.dataset.estado) + 1]; if (!seguinte) return;
        App.run(btn, async () => {
            await App.api('PUT', '/Literatura/Pedido/', { stamp: it.dataset.stamp, qtd: it.dataset.qtd, estado: seguinte });
            mudarEstado(it, seguinte); aplicar('esp'); estatisticas(); notify('Pedido marcado como «' + seguinte + '».');
        }, 'Não foi possível atualizar o pedido.');
    });

    // ---------- Criar e editar ----------
    App.on('criarEsp', btn => App.run(btn, async () => {
        const pub = App.$('#txtIdPublicador').value, stamp = App.$('#txtPubStamp').value, qtd = App.lerInt('#txtQtd');
        if (pub === '') return App.campo('#txtIdPublicador', 'Escolha o publicador.');
        if (!stamp) return App.campo('#txtPub', 'Escolha uma publicação da lista de sugestões.');
        if (qtd < 1) return App.campo('#txtQtd', 'Indique uma quantidade positiva.');
        await App.api('POST', '/Literatura/Pedido/', { stamp: stamp, idpub: pub, qtd: qtd });
        M('modalPedidoEspecial').close(); pesq.limpar(); App.$('#txtQtd').value = 1;
        await recarregar(); notify('Pedido registado.');
    }, 'Não foi possível registar o pedido.'));

    App.on('criarPer', btn => App.run(btn, async () => {
        const pub = App.$('#txtIdPublicador2').value, qtd = App.lerInt('#txtQtdPeriodico');
        if (pub === '') return App.campo('#txtIdPublicador2', 'Escolha o publicador.');
        if (qtd < 1) return App.campo('#txtQtdPeriodico', 'Indique uma quantidade positiva.');
        await App.api('POST', '/Literatura/Periodico/', { referencia: App.$('#periodico').value, idpub: pub, qtd: qtd });
        M('modalPedidoPeriodico').close(); App.$('#txtQtdPeriodico').value = 1;
        await recarregar(); notify('Pedido registado.');
    }, 'Não foi possível registar o pedido.'));

    function marcarEstado(v) {
        estadoSel = v;
        App.$$('.field-msg', App.$('#chipsEstado').closest('.field')).forEach(m => m.remove());
        App.$$('#chipsEstado .chip').forEach(c => c.setAttribute('aria-pressed', c.dataset.estado === v));
    }
    App.on('editarEsp', btn => {
        atual = btn.closest('.item');
        App.$('#estNome').textContent = atual.dataset.desc + ' · ' + atual.dataset.pub;
        App.$('#txtQtdPedido').value = atual.dataset.qtd;
        marcarEstado(atual.dataset.estado);
        M('modalEstado').open();
    });
    document.getElementById('chipsEstado').addEventListener('click', e => { const c = e.target.closest('.chip'); if (c) marcarEstado(c.dataset.estado); });

    App.on('guardarEstado', btn => App.run(btn, async () => {
        if (!estadoSel) return App.campo('#chipsEstado', 'Escolha o estado.');
        const qtd = App.lerInt('#txtQtdPedido'); if (qtd < 1) return App.campo('#txtQtdPedido', 'Indique uma quantidade positiva.');
        await App.api('PUT', '/Literatura/Pedido/', { stamp: atual.dataset.stamp, qtd: qtd, estado: estadoSel });
        M('modalEstado').close(); await recarregar(); notify('Pedido atualizado.');
    }, 'Não foi possível atualizar o pedido.'));

    // ---------- Emails ----------
    App.on('enviarEsp', btn => App.run(btn, async () => {
        const email = App.$('#txtEmailPedidos').value.trim(); if (!email) return App.campo('#txtEmailPedidos', 'Indique o email de destino.');
        await App.api('POST', '/Literatura/Pedidos/', { email: email });
        guardarEmail(email); M('modalMailPedidos').close(); await recarregar(); notify('Pedidos especiais enviados.');
    }, 'Não foi possível enviar os pedidos especiais.'));

    App.on('enviarPer', btn => App.run(btn, async () => {
        const email = App.$('#txtEmailPeriodicos').value.trim(); if (!email) return App.campo('#txtEmailPeriodicos', 'Indique o email de destino.');
        await App.api('POST', '/Literatura/Periodicos/' + App.$('#mailperiodico').value, { email: email });
        guardarEmail(email); M('modalMailPeriodicos').close(); notify('Pedidos de periódicos enviados.');
    }, 'Não foi possível enviar os pedidos de periódicos.'));

    tudo();
</script>
}
