@model IEnumerable<JW_Management.Models.Movimentos>
@{
    ViewData["Title"] = "Literatura - Saídas";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div><h1>Saídas</h1></div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalSaida">
                <span class="icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span><span>Registar saída</span>
            </button>
            <a class="button is-info is-light" href="~/Literatura/Periodicos">
                <span class="icon"><i class="fa-solid fa-newspaper"></i></span><span>Periódicos a entregar</span>
            </a>
        </div>
    </div>

    <partial name="_BarraData" />
    <div id="regiao"><partial name="_Movimentos" model="Model" /></div>
</div>

<div id="modalSaida" class="modal" role="dialog" aria-modal="true" aria-labelledby="tSaida">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tSaida"><span class="icon"><i class="fa-solid fa-circle-minus"></i></span><span>Saída de publicações</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" id="lblPublicador" for="txtPublicadorBusca">Publicador</label>
                <div id="buscaPub"><input type="text" class="input" id="txtPublicadorBusca" placeholder="Escreva o nome do publicador"></div>
                <div id="fichaPub" class="pub-ficha" hidden aria-live="polite">
                    <span id="fichaAvatar"></span><strong id="fichaNome"></strong>
                    <button type="button" class="button is-ghost" data-action="alterarPub">Alterar</button>
                </div>
                <input type="hidden" id="txtIdPublicador" />
            </div>
            <div class="field">
                <label class="label" for="txtPub">Publicação</label>
                <div><input type="text" class="input" id="txtPub" placeholder="Escreva a referência ou o nome"></div>
                <input type="hidden" id="txtPubStamp" />
            </div>
            <div class="field">
                <label class="label" for="txtQtd">Quantidade</label>
                <partial name="_Stepper" model='("txtQtd", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info is-light" data-action="guardarOutra"><span class="icon"><i class="fa-solid fa-plus"></i></span><span>Guardar e registar outra</span></button>
            <button type="button" class="button is-info" data-action="guardar" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<partial name="_ScriptMovimentos" />
<script>
    const modalSaida = App.modal('modalSaida');
    const pesq = App.pesquisaPublicacao('#txtPub', '#txtPubStamp', false);
    const pesqPub = App.pesquisaPublicador('#txtPublicadorBusca', '#txtIdPublicador', true);

    // Escolhido o publicador, fica numa ficha fixa até se alterar ou fechar o modal: um lote de saídas
    // não pode ser atribuído por engano à pessoa do registo anterior sem estar à vista.
    function mostrarFicha(sim) {
        App.$('#buscaPub').hidden = sim; App.$('#fichaPub').hidden = !sim;
        if (!sim) return;
        const id = App.$('#txtIdPublicador').value, nome = App.$('#txtPublicadorBusca').value;
        App.$('#fichaNome').textContent = nome;
        const av = App.$('#fichaAvatar'); av.innerHTML = '';
        if (+id > 0) av.appendChild(App.avatar(+id, nome, ''));
    }
    App.$('#txtIdPublicador').addEventListener('change', e => { if (e.target.value !== '') mostrarFicha(true); });
    App.on('alterarPub', () => { pesqPub.limpar(); mostrarFicha(false); App.$('#txtPublicadorBusca').focus(); });
    function repor() { pesq.limpar(); pesqPub.limpar(); App.$('#txtQtd').value = 1; mostrarFicha(false); }
    App.$('#modalSaida').addEventListener('closed', repor);

    async function registar(btn, outra) {
        return App.run(btn, async () => {
            const stamp = App.$('#txtPubStamp').value, pub = App.$('#txtIdPublicador').value, qtd = App.lerInt('#txtQtd');
            if (pub === '') return App.campo('#txtPublicadorBusca', 'Escolha um publicador da lista de sugestões.');
            if (!stamp) return App.campo('#txtPub', 'Escolha uma publicação da lista de sugestões.');
            if (qtd < 1) return App.campo('#txtQtd', 'Indique uma quantidade positiva.');
            await App.saida(stamp, qtd, pub);
            if (outra) { pesq.limpar(); App.$('#txtQtd').value = 1; App.$('#txtPub').focus(); } else modalSaida.close();
            await App.refresh('#regiao'); notify('Saída registada.');
        }, 'Não foi possível registar a saída.');
    }
    App.on('guardar', btn => registar(btn, false));
    App.on('guardarOutra', btn => registar(btn, true));
</script>
}
