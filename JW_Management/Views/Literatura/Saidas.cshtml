@model IEnumerable<JW_Management.Models.Movimentos>
@{
    ViewData["Title"] = "Literatura - Saídas";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div><h1>Saídas</h1></div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalSaida">
                <span class="icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span><span>Registar saída</span>
            </button>
            <a class="button is-info is-light" href="~/Literatura/Periodicos">
                <span class="icon"><i class="fa-solid fa-newspaper"></i></span><span>Periódicos a entregar</span>
            </a>
        </div>
    </div>

    <partial name="_BarraData" />
    <div id="regiao"><partial name="_Movimentos" model="Model" /></div>
</div>

<div id="modalSaida" class="modal" role="dialog" aria-modal="true" aria-labelledby="tSaida">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tSaida"><span class="icon"><i class="fa-solid fa-circle-minus"></i></span><span>Saída de publicações</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtIdPublicador">Publicador</label>
                <div class="select is-fullwidth">
                    <select id="txtIdPublicador">
                        <option value="" disabled selected>Escolha o publicador…</option>
                        <option value="0">Congregação (sem publicador)</option>
                        @foreach (var p in (IEnumerable<SelectListItem>)ViewBag.Publicadores)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtPub">Publicação</label>
                <div><input type="text" class="input" id="txtPub" placeholder="Escreva a referência ou o nome"></div>
                <input type="hidden" id="txtPubStamp" />
            </div>
            <div class="field">
                <label class="label" for="txtQtd">Quantidade</label>
                <partial name="_Stepper" model='("txtQtd", 1, 1)' />
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="guardar" data-submit><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<partial name="_ScriptMovimentos" />
<script>
    const modalSaida = App.modal('modalSaida');
    const pesq = App.pesquisaPublicacao('#txtPub', '#txtPubStamp', false);

    App.on('guardar', btn => App.run(btn, async () => {
        const stamp = App.$('#txtPubStamp').value, pub = App.$('#txtIdPublicador').value, qtd = App.lerInt('#txtQtd');
        if (pub === '') return App.campo('#txtIdPublicador', 'Escolha o publicador.');
        if (!stamp) return App.campo('#txtPub', 'Escolha uma publicação da lista de sugestões.');
        if (qtd < 1) return App.campo('#txtQtd', 'Indique uma quantidade positiva.');
        await App.saida(stamp, qtd, pub);
        modalSaida.close(); pesq.limpar(); App.$('#txtQtd').value = 1;
        await App.refresh('#regiao'); notify('Saída registada.');
    }, 'Não foi possível registar a saída.'));
</script>
}
