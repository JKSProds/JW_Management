@model IEnumerable<JW_Management.Models.Literatura>
@{
    ViewData["Title"] = "Periódico - Saída";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <span class="head-icon"><i class="fa-solid fa-newspaper"></i></span>
            <div>
                <h1>Saída de periódicos</h1>
                <p><span id="total" class="num">@Math.Abs(Model.Sum(l => l.Quantidade))</span> exemplares por entregar</p>
            </div>
        </div>
        <div class="head-actions">
            <a class="button is-info is-light" href="~/Literatura/Periodicos">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Periódicos</span>
            </a>
        </div>
    </div>

    <div class="items" id="lista">
        @foreach (var item in Model)
        {
            <article class="item no-thumb" data-stamp="@item.Stamp" data-qtd="@item.Quantidade" data-pub="@item.Publicador!.Id">
                <div class="main">
                    <div class="name">@item.Publicador.Nome</div>
                    <div class="meta">
                        <span><i class="fa-solid fa-user-group fa-xs"></i> @item.Publicador.Grupo?.Responsavel?.Nome [@item.Publicador.Grupo?.Id]</span>
                    </div>
                </div>
                <div class="side">
                    <div class="qty num"><span>@Math.Abs(item.Quantidade)</span><small>exemplares</small></div>
                    <div class="acts">
                        <button type="button" class="button is-success" data-action="entregar">
                            <span class="icon"><i class="fa-solid fa-circle-check"></i></span><span>Entregue</span>
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
    <div class="empty-state" id="vazio" @(Model.Any() ? "hidden" : "")>
        <span class="icon"><i class="fa-regular fa-circle-check"></i></span>
        <strong>Sem exemplares por entregar</strong>
        Todos os pedidos deste periódico foram entregues.
    </div>
</div>

@section Scripts {
<script>
    const atualizar = () => {
        const itens = App.$$('#lista .item');
        App.$('#vazio').hidden = itens.length > 0;
        App.$('#total').textContent = itens.reduce((s, i) => s + Math.abs(+i.dataset.qtd), 0);
    };
    App.$('#lista').addEventListener('changed', atualizar);

    App.on('entregar', btn => {
        const it = btn.closest('.item');
        App.run(btn, async () => {
            await App.saida(it.dataset.stamp, +it.dataset.qtd, it.dataset.pub);
            App.removeItem(it); notify('Entrega registada.');
        }, 'Não foi possível registar a entrega.');
    });
</script>
}
