@model IEnumerable<JW_Management.Models.Literatura>
@{
    ViewData["Title"] = "Periódicos";
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <span class="head-icon"><i class="fa-solid fa-newspaper"></i></span>
            <div><h1>Periódicos a entregar</h1><p>Ordenados por urgência de entrega</p></div>
        </div>
        <div class="head-actions">
            <a class="button is-info is-light" href="~/Literatura/Movimentos/2">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Saídas</span>
            </a>
        </div>
    </div>

    <div id="grupos">
        @foreach (var g in Model.GroupBy(p => p.DescricaoGeral))
        {
            <section class="grupo">
                <h2 class="group-title">@g.Key</h2>
                <div class="items">
                    @foreach (var item in g)
                    {
                        var tom = item.Entrega < 10 ? "tone-bad" : (item.Entrega < 30 ? "tone-warn" : "");
                        <article class="item @tom" data-stamp="@item.Stamp" data-qtd="@item.Quantidade">
                            <div class="thumb"><img src="@item.URL" alt="" loading="lazy" onerror="this.src='/img/l_no_photo.png'"></div>
                            <div class="main">
                                <div class="name">@item.Descricao</div>
                                <div class="meta">
                                    <span class="ref-tag">@item.Referencia</span>
                                    <span><i class="fa-regular fa-clock fa-xs"></i> <span class="num">@(item.Entrega < 0 ? 0 : item.Entrega)</span> dia(s)</span>
                                </div>
                            </div>
                            <div class="side">
                                <div class="qty num"><span>@item.QuantidadeFalta / @item.Quantidade</span><small>por entregar</small></div>
                                <div class="acts">
                                    <a class="button btn-icon" href="~/Literatura/Periodico/@item.Stamp" aria-label="Ver pedidos" title="Ver pedidos"><i class="fa-solid fa-eye"></i></a>
                                    <button type="button" class="button btn-icon is-ok-hover" data-action="finalizar" aria-label="Finalizar entrega" title="Finalizar entrega"><i class="fa-solid fa-circle-check"></i></button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        <div class="empty-state" id="vazio" @(Model.Any() ? "hidden" : "")>
            <span class="icon"><i class="fa-regular fa-circle-check"></i></span>
            <strong>Não há periódicos por entregar</strong>
            Quando houver pedidos com exemplares em stock, aparecem aqui.
        </div>
    </div>
</div>

@section Scripts {
<script>
    App.on('finalizar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({
            title: 'Finalizar periódico',
            text: 'Finalizar a entrega de «' + App.$('.name', it).textContent + '»? Ainda podem existir exemplares por entregar.',
            ok: 'Finalizar', danger: false
        })) return;
        App.run(btn, async () => {
            await App.api('POST', '/Literatura/Movimentos/', { stamp: it.dataset.stamp, qtd: -it.dataset.qtd, idpub: 0 });
            const grupo = it.closest('.grupo');
            App.removeItem(it);
            setTimeout(() => {
                if (!App.$('.item', grupo)) grupo.remove();
                App.$('#vazio').hidden = !!App.$('.grupo');
            }, 300);
            notify('Entrega finalizada.');
        }, 'Não foi possível finalizar a entrega.');
    });
</script>
}
