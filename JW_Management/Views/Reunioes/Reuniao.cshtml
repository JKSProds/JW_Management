@model JW_Management.Models.Reuniao
@{
    ViewData["Title"] = "Reunião";
    var designacoes = Model.Designacoes ?? new();
    var separadores = new (int Base, string Titulo, string Icone)[]
    {
        (0, "Tesouros", "fa-gem"), (100, "Ministério", "fa-people-arrows"), (200, "Viver como cristãos", "fa-hand-holding-heart"),
        (300, "Fim de semana", "fa-book"), (400, "A Sentinela", "fa-book-open"), (500, "Responsabilidades", "fa-person-circle-check")
    };
    var publicadores = ((IEnumerable<SelectListItem>)ViewBag.Publicadores).ToList();
    var canticos = ((IEnumerable<SelectListItem>)ViewBag.Canticos).ToList();
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>@Model.SemanaReuniao</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalDesignacao">
                <span class="icon"><i class="fa-solid fa-clipboard-list"></i></span><span>Adicionar designação</span>
            </button>
            <a class="button is-info is-light" href="~/Reunioes">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Reuniões</span>
            </a>
        </div>
    </div>

    @if (!designacoes.Any())
    {
        <div class="empty-state">
            <span class="icon"><i class="fa-solid fa-clipboard-list"></i></span>
            <strong>Esta reunião não tem designações</strong>
            Não existem tipos de designação para a preencher. Importe as reuniões do Hourglass (cria os tipos) ou adicione uma designação.
        </div>
    }
    else
    {
    <div id="regiao">
        @await Html.PartialAsync("_Stats", new[] {
            ("fa-clipboard-list", "Designações", designacoes.Count.ToString(), "", ""),
            ("fa-user-check", "Atribuídas", designacoes.Count(d => d.Atribuida).ToString(), "", "is-ok"),
            ("fa-user-clock", "Por atribuir", designacoes.Count(d => !d.Atribuida).ToString(), "", designacoes.Any(d => !d.Atribuida) ? "is-warn" : ""),
            ("fa-music", "Cânticos definidos", Model.Canticos.Count(c => c.Id > 0) + " de " + Model.Canticos.Count, "", "") })

        <div class="panel-card mb-4">
            <h2>Cânticos</h2>
            <div class="form-grid">
                @foreach (var c in Model.Canticos)
                {
                    <div class="field">
                        <div class="select is-fullwidth">
                            <select data-action-change="cantico" data-stamp="@c.Stamp" aria-label="Cântico">
                                @foreach (var o in canticos) { <option value="@o.Value" selected="@(o.Value == c.Id.ToString())">@o.Text</option> }
                            </select>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="seg" role="tablist" aria-label="Secções da reunião">
            @for (var i = 0; i < separadores.Length; i++)
            {
                var sep = separadores[i];
                <button type="button" role="tab" id="tab@(sep.Base)" aria-controls="pan@(sep.Base)" aria-selected="@(i == 0 ? "true" : "false")">@sep.Titulo<span class="count">@Model.ObterDesignacoesTipo(sep.Base).Count</span></button>
            }
        </div>

        @foreach (var sep in separadores)
        {
            <section id="pan@(sep.Base)" role="tabpanel" aria-labelledby="tab@(sep.Base)" @(sep.Base == 0 ? "" : "hidden")>
                @if (!Model.ObterDesignacoesTipo(sep.Base).Any())
                {
                    <div class="empty-state"><span class="icon"><i class="fa-solid @sep.Icone"></i></span><strong>Sem designações nesta secção</strong></div>
                }
                <div class="dg-grid">
                @foreach (var item in Model.ObterDesignacoesTipo(sep.Base))
                {
                    var grupo = designacoes.Where(d => d.TipoDesignacao!.Id == item.TipoDesignacao!.Id && d.Local == item.Local).ToList();
                    var pendente = grupo.Any(u => !u.Atribuida);
                    <article class="dg panel-card" data-stamps="@string.Join(",", grupo.Select(g => g.Stamp))">
                        <header class="dg-head">
                            <h3>@item.TipoDesignacao!.Descricao</h3>
                            @if (item.TipoDesignacao.Salas > 1) { <span class="tag is-light">@item.Local</span> }
                            <span class="tag dg-estado @(pendente ? "is-warning" : "is-success")">@(pendente ? "Por atribuir" : "Atribuída")</span>
                            <span class="tag is-info dg-dirty" hidden>Alterada</span>
                        </header>
                        <div class="form-grid dg-campos">
                            <div class="field"><label class="label">Tema</label><input class="input tema" type="text" value="@item.NomeDesignacao" placeholder="Tema da designação"></div>
                            <div class="field dg-min"><label class="label">Minutos</label><input class="input minutos" type="number" min="0" value="@item.NMin"></div>
                        </div>
                        <div class="dg-pessoas">
                            @foreach (var u in grupo)
                            {
                                <div class="input-action pessoa" data-stamp="@u.Stamp">
                                    <div class="control">
                                        <div class="select is-fullwidth">
                                            <select class="pub" aria-label="Publicador">
                                                @foreach (var p in publicadores) { <option value="@p.Value" selected="@(p.Value == u.Publicador!.Id.ToString())">@p.Text</option> }
                                            </select>
                                        </div>
                                    </div>
                                    <button type="button" class="button btn-icon is-danger-hover" data-action="apagarPessoa" aria-label="Remover publicador" title="Remover"><i class="fa-solid fa-user-minus"></i></button>
                                </div>
                            }
                        </div>
                        <footer class="dg-foot">
                            <button type="button" class="button is-info is-light" data-action="addPessoa"><span class="icon"><i class="fa-solid fa-user-plus"></i></span><span>Publicador</span></button>
                            <button type="button" class="button is-info" data-action="guardar"><span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar</span></button>
                            <button type="button" class="button btn-icon is-danger-hover" data-action="apagarGrupo" aria-label="Apagar designação" title="Apagar designação"><i class="fa-solid fa-trash-can"></i></button>
                        </footer>
                    </article>
                }
                </div>
            </section>
        }
    </div>
    }
</div>

<div id="modalDesignacao" class="modal" role="dialog" aria-modal="true" aria-labelledby="tD">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tD"><span class="icon"><i class="fa-solid fa-clipboard-list"></i></span><span>Adicionar designação</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtIdTipo">Tipo</label>
                <div class="select is-fullwidth"><select id="txtIdTipo" asp-items="@(new SelectList(ViewBag.Tipos, "Value", "Text"))"></select></div>
            </div>
            <div class="field">
                <label class="label" for="txtLocal">Sala</label>
                <div class="select is-fullwidth"><select id="txtLocal"><option value="Auditório">Auditório</option><option value="Sala 2">Sala 2</option></select></div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criarDg" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Adicionar</span></button>
        </footer>
    </div>
</div>

<div id="modalPessoa" class="modal" role="dialog" aria-modal="true" aria-labelledby="tP">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tP"><span class="icon"><i class="fa-solid fa-user-plus"></i></span><span>Adicionar publicador</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtIdPubAdd">Publicador</label>
                <div class="select is-fullwidth"><select id="txtIdPubAdd">@foreach (var p in publicadores) { <option value="@p.Value">@p.Text</option> }</select></div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criarPessoa" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Adicionar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    const reuniao = '@Model.Stamp';
    const recarregar = () => App.refresh('#regiao');
    let alvo = null;

    // «Alterada» aparece assim que algo no cartão muda
    document.addEventListener('input', e => { const c = e.target.closest('.dg'); if (c) App.$('.dg-dirty', c).hidden = false; });
    document.addEventListener('change', e => { const c = e.target.closest('.dg'); if (c) App.$('.dg-dirty', c).hidden = false; });

    // Cânticos: guardam ao escolher
    document.addEventListener('change', async e => {
        const s = e.target.closest('[data-action-change="cantico"]'); if (!s) return;
        try { await App.api('PUT', '/Reunioes/Cantico/', { id: s.value, stamp: s.dataset.stamp }); notify('Cântico atualizado.'); recarregar(); }
        catch (x) { notifyError('Não foi possível atualizar o cântico.'); }
    });

    App.on('guardar', btn => App.run(btn, async () => {
        const c = btn.closest('.dg'), minutos = App.$('.minutos', c).value || 0, tema = App.$('.tema', c).value;
        for (const p of App.$$('.pessoa', c)) await App.api('PUT', '/Reunioes/Designacao/', { id: p.dataset.stamp, pub: App.$('.pub', p).value, minutos: minutos, tema: tema });
        await recarregar(); notify('Designação guardada.');
    }, 'Não foi possível guardar a designação.'));

    App.on('apagarGrupo', async btn => {
        const c = btn.closest('.dg');
        if (!await App.confirm({ title: 'Apagar designação', text: 'Apagar «' + App.$('h3', c).textContent + '» e os publicadores associados?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Reunioes/Designacao/', { id: c.dataset.stamps }); await recarregar(); notify('Designação apagada.'); }, 'Não foi possível apagar a designação.');
    });

    App.on('apagarPessoa', async btn => {
        const p = btn.closest('.pessoa'), c = btn.closest('.dg');
        const unica = App.$$('.pessoa', c).length === 1;
        if (!await App.confirm({ title: 'Remover publicador', text: unica ? 'É o único publicador: a designação será apagada.' : 'Remover este publicador da designação?', ok: 'Remover' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Reunioes/Designacao/', { id: p.dataset.stamp }); await recarregar(); notify('Removido.'); }, 'Não foi possível remover.');
    });

    App.on('addPessoa', btn => { alvo = App.$('.pessoa', btn.closest('.dg')).dataset.stamp; App.modal('modalPessoa').open(); });
    App.on('criarPessoa', btn => App.run(btn, async () => {
        await App.api('POST', '/Reunioes/Publicador/', { id: alvo, pub: App.$('#txtIdPubAdd').value });
        App.modal('modalPessoa').close(); await recarregar(); notify('Publicador adicionado.');
    }, 'Não foi possível adicionar o publicador.'));

    App.on('criarDg', btn => App.run(btn, async () => {
        await App.api('POST', '/Reunioes/Designacao/', { id: reuniao, tipo: App.$('#txtIdTipo').value, local: App.$('#txtLocal').value });
        App.modal('modalDesignacao').close();
        if (App.$('#regiao')) { await recarregar(); notify('Designação criada.'); } else location.reload(); // sem designações ainda não há região a atualizar
    }, 'Não foi possível criar a designação.'));
</script>
}
