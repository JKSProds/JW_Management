@model IEnumerable<JW_Management.Models.Discurso>
@{
    ViewData["Title"] = "Discursos";
    var hoje = DateTime.Today;
    var ordenados = Model.OrderByDescending(d => d.DataDiscurso).ToList();
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Discursos públicos</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalDiscurso">
                <span class="icon"><i class="fa-solid fa-microphone-lines"></i></span><span>Criar discurso</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-microphone-lines", "Discursos", ordenados.Count.ToString(), "sTot", ""),
        ("fa-calendar-day", "Por realizar", ordenados.Count(d => d.DataDiscurso.Date >= hoje).ToString(), "sProx", "is-ok"),
        ("fa-people-arrows", "Oradores externos", ordenados.Count(d => d.OradorExterno).ToString(), "sExt", "") })

    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar por orador, congregação ou tema" aria-label="Pesquisar discursos">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar">
            <button type="button" class="chip" data-type="0" aria-pressed="true">Todos</button>
            <button type="button" class="chip" data-type="futuro" aria-pressed="false">Por realizar</button>
            <button type="button" class="chip" data-type="passado" aria-pressed="false">Realizados</button>
        </div>
    </div>

    <div id="lista" class="items">
        @foreach (var item in ordenados)
        {
            <article class="item no-thumb" data-stamp="@item.Stamp" data-type="@(item.DataDiscurso.Date >= hoje ? "futuro" : "passado") @(item.OradorExterno ? "externo" : "")"
                     data-externo="@(item.OradorExterno ? 1 : 0)" data-search="@item.NomePublicador @item.Congregacao @item.TemaDiscurso @item.NumDiscurso">
                <div class="main">
                    <div class="name"><span class="ref-tag id-badge">@item.NumDiscurso</span> @item.TemaDiscurso</div>
                    <div class="meta">
                        <span><i class="fa-solid fa-user fa-xs"></i> @item.NomePublicador</span>
                        <span>@item.Congregacao</span>
                        <span class="num">@item.DataDiscurso.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                <div class="side">
                    <div class="acts">
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar discurso" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>
    <div id="vazio" class="empty-state" hidden>
        <span class="icon"><i class="fa-solid fa-microphone-lines"></i></span>
        <strong>Não foram encontrados discursos</strong>
        Crie um discurso ou importe as reuniões do Hourglass.
    </div>
</div>

<div id="modalDiscurso" class="modal" role="dialog" aria-modal="true" aria-labelledby="tDi">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tDi"><span class="icon"><i class="fa-solid fa-microphone-lines"></i></span><span>Adicionar discurso</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="dPub">Orador (publicador da congregação)</label>
                <div class="select is-fullwidth">
                    <select id="dPub">
                        <option value="0" selected>Orador externo: escreva o nome abaixo</option>
                        @foreach (var p in ((IEnumerable<SelectListItem>)ViewBag.Publicadores).Where(p => p.Value != "0")) { <option value="@p.Value">@p.Text</option> }
                    </select>
                </div>
            </div>
            <div class="form-grid">
                <div class="field"><label class="label" for="dNome">Nome do orador externo</label><input class="input" id="dNome" type="text" autocomplete="off"></div>
                <div class="field"><label class="label" for="dCong">Congregação</label><input class="input" id="dCong" type="text" autocomplete="off"></div>
            </div>
            <div class="field">
                <label class="label" for="dTema">Discurso</label>
                <div class="select is-fullwidth">
                    <select id="dTema">
                        <option value="0" selected disabled>Escolha um tema</option>
                        @foreach (var t in (IEnumerable<SelectListItem>)ViewBag.Discursos) { <option value="@t.Value">@t.Text</option> }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="dData">Data</label>
                <input type="date" class="input" id="dData" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criar" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Criar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    App.filtro({
        lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio',
        aoAplicar: v => App.stats({ sTot: v.length, sProx: v.filter(i => i.dataset.type.includes('futuro')).length, sExt: v.filter(i => i.dataset.externo === '1').length })
    });

    App.on('criar', btn => App.run(btn, async () => {
        const tema = App.$('#dTema').value, pub = App.$('#dPub').value, nome = App.$('#dNome').value.trim();
        if (pub === '0' && !nome) return App.campo('#dNome', 'Escolha um publicador ou escreva o nome do orador.');
        if (pub === '0' && !App.$('#dCong').value.trim()) return App.campo('#dCong', 'Indique a congregação do orador.');
        if (tema === '0') return App.campo('#dTema', 'Escolha o tema.');
        if (!App.$('#dData').value) return App.campo('#dData', 'Indique a data.');
        await App.api('POST', '/Reunioes/Discurso/', { txtIdPub: pub, txtNomePub: nome, txtCongPub: App.$('#dCong').value.trim(), txtIdDiscurso: tema, txtData: App.$('#dData').value });
        App.modal('modalDiscurso').close(); await App.refresh('#lista'); notify('Discurso criado.');
    }, 'Não foi possível criar o discurso.'));

    App.on('apagar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar discurso', text: 'Apagar este discurso definitivamente?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Reunioes/Discurso/', { id: it.dataset.stamp }); App.removeItem(it); notify('Discurso apagado.'); }, 'Não foi possível apagar o discurso.');
    });
</script>
}
