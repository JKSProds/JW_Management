@model IEnumerable<JW_Management.Models.Reuniao>
@{
    ViewData["Title"] = "Reuniões";
    var meses = new[] { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Reuniões</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalCriar">
                <span class="icon"><i class="fa-solid fa-calendar-plus"></i></span><span>Criar reunião</span>
            </button>
            <button type="button" class="button is-info is-light" data-open="modalHourglass">
                <span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Importar do Hourglass</span>
            </button>
            <button type="button" class="button is-info is-light" data-open="modalPrograma">
                <span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>Gerar programa</span>
            </button>
            <button type="button" class="button is-info is-light" data-open="modalFicheiro">
                <span class="icon"><i class="fa-solid fa-file-excel"></i></span><span>Importar Excel</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-calendar-days", "Reuniões registadas", Model.Count().ToString(), "sTot", ""),
        ("fa-calendar-check", "Mais recente", Model.Any() ? Model.Last().SemanaReuniao ?? "—" : "—", "", "") })

    <div id="lista" class="items">
        @foreach (var item in Model)
        {
            <article class="item no-thumb" data-stamp="@item.Stamp">
                <div class="main"><div class="name">@item.SemanaReuniao</div></div>
                <div class="side">
                    <div class="acts">
                        <a class="button is-info" href="~/Reunioes/Reuniao/@item.Stamp"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span><span>Abrir</span></a>
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar @item.SemanaReuniao" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>
    <div id="vazio" class="empty-state" @(Model.Any() ? "hidden" : "")>
        <span class="icon"><i class="fa-solid fa-calendar-days"></i></span>
        <strong>Ainda não há reuniões</strong>
        Crie uma reunião, importe-as do Hourglass ou de um ficheiro Excel.
    </div>
</div>

<div id="modalCriar" class="modal" role="dialog" aria-modal="true" aria-labelledby="tCr">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tCr"><span class="icon"><i class="fa-solid fa-calendar-plus"></i></span><span>Criar reunião</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label" for="txtData">Uma data da semana</label>
                <input type="date" class="input" id="txtData" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                <p class="field-hint">A reunião é criada com todos os tipos de designação existentes.</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criar" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Criar</span></button>
        </footer>
    </div>
</div>

<div id="modalFicheiro" class="modal" role="dialog" aria-modal="true" aria-labelledby="tFi">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tFi"><span class="icon"><i class="fa-solid fa-file-excel"></i></span><span>Importar ficheiro Excel</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <form action="/Reunioes/Reunioes" method="POST" class="dropzone" id="frmExcel">
                <div class="dz-message needsclick">Largue aqui o ficheiro ou toque para escolher</div>
            </form>
        </section>
        <footer class="modal-card-foot"><button type="button" class="button is-info" data-close>Fechar</button></footer>
    </div>
</div>

<div id="modalPrograma" class="modal" role="dialog" aria-modal="true" aria-labelledby="tPg">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tPg"><span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>Programa mensal de atividades</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4">Gera um PDF com uma coluna por semana (reuniões, indicadores e sistema sonoro), a partir do Hourglass. Cole um pedido «Copiar como cURL» do Hourglass, como na importação.</p>
            <div class="form-grid">
                <div class="field">
                    <label class="label" for="pgMes">Mês</label>
                    <div class="select is-fullwidth">
                        <select id="pgMes">
                            @for (var i = 0; i < 12; i++) { <option value="@(i + 1)" selected="@(i + 1 == DateTime.Now.Month)">@meses[i]</option> }
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="pgAno">Ano</label>
                    <input type="number" class="input" id="pgAno" value="@DateTime.Now.Year" min="2020" max="2100">
                </div>
            </div>
            <div class="field">
                <label class="label" for="pgDir">Dirigente de A Sentinela por omissão</label>
                <input class="input" id="pgDir" type="text" value="Filipe Gonçalves" autocomplete="off">
                <p class="field-hint">Usado nas semanas em que o Hourglass não indica dirigente.</p>
            </div>
            <div class="field">
                <label class="label" for="pgCookie">Pedido copiado (ou só a cookie)</label>
                <textarea class="textarea" id="pgCookie" rows="3" spellcheck="false" autocomplete="off" placeholder="curl 'https://app.hourglass-app.com/...' -H 'Cookie: ...'"></textarea>
                <p class="field-hint">Só se fazem leituras no Hourglass. A cookie não é guardada.</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="gerarPrograma" data-submit><span class="icon"><i class="fa-solid fa-file-arrow-down"></i></span><span>Gerar PDF</span></button>
        </footer>
    </div>
</div>

<div id="modalHourglass" class="modal" role="dialog" aria-modal="true" aria-labelledby="tHg" data-persist="1">
    <div class="modal-background"></div>
    <div class="modal-card is-wide">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tHg"><span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Importar reuniões do Hourglass</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div id="hgPasso1">
                <ol class="steps">
                    <li>Abra o <a href="https://app.hourglass-app.com/v2/page/app/scheduling/mm" target="_blank" rel="noopener">Hourglass</a> com a sessão iniciada (Agendamento, Reunião de meio de semana).</li>
                    <li>Prima <kbd>F12</kbd>, abra o separador <b>Rede</b> e recarregue a página.</li>
                    <li>Num pedido <b>schedule</b>: botão direito, <b>Copiar</b>, <b>Copiar como cURL</b>, e cole abaixo.</li>
                </ol>
                <div class="field">
                    <label class="label" for="hgCookie">Pedido copiado (ou só a cookie)</label>
                    <textarea class="textarea" id="hgCookie" rows="3" spellcheck="false" autocomplete="off" placeholder="curl 'https://app.hourglass-app.com/...' -H 'Cookie: ...'"></textarea>
                    <p class="field-hint">Só se fazem leituras no Hourglass. A cookie não é guardada e deixa de servir quando terminar a sessão.</p>
                </div>
                <div class="form-grid">
                    <div class="field"><label class="label" for="hgDe">De</label><input type="date" class="input" id="hgDe"></div>
                    <div class="field"><label class="label" for="hgAte">Até</label><input type="date" class="input" id="hgAte"></div>
                </div>
            </div>
            <div id="hgPasso2" hidden></div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" id="hgObter" data-action="hgObter" data-submit><span class="icon"><i class="fa-solid fa-cloud-arrow-down"></i></span><span>Obter programa</span></button>
            <button type="button" class="button is-success" id="hgImportar" data-action="hgImportar" hidden><span class="icon"><i class="fa-solid fa-file-import"></i></span><span>Importar selecionadas</span></button>
        </footer>
    </div>
</div>


@section Scripts {
<script>
    App.on('criar', btn => App.run(btn, async () => {
        const d = App.$('#txtData').value; if (!d) return App.campo('#txtData', 'Indique uma data.');
        const r = await fetch('/Reunioes/Reuniao', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ data: d }) });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        location.href = r.url; // o servidor redireciona para a reunião criada
    }, 'Não foi possível criar a reunião.'));

    App.on('apagar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar reunião', text: 'Apagar «' + App.$('.name', it).textContent + '» e todas as designações associadas?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Reunioes/Reuniao/', { id: it.dataset.stamp }); App.removeItem(it); setTimeout(() => App.stats({ sTot: App.$$('#lista .item').length }), 300); notify('Reunião apagada.'); },
            'Não foi possível apagar a reunião.');
    });

    document.addEventListener('DOMContentLoaded', () => {
        const dz = Dropzone.forElement('#frmExcel');
        dz.on('success', async () => { notify('Ficheiro importado.'); await App.refresh('#lista'); App.$('#vazio').hidden = App.$$('#lista .item').length > 0; });
        dz.on('error', () => notifyError('Não foi possível importar o ficheiro.'));
    });

    // Programa mensal em PDF (lido do Hourglass)
    App.on('gerarPrograma', btn => {
        const bruto = App.$('#pgCookie').value.trim(); if (!bruto) return App.campo('#pgCookie', 'Cole o pedido ou a cookie primeiro.');
        const cookie = App.extrairCookie(bruto);
        if (!/hglogin=/.test(cookie) || !/X-Hourglass-XSRF-Token=/.test(cookie)) return App.campo('#pgCookie', 'Não encontrei a sessão do Hourglass (hglogin e token XSRF). Use «Copiar como cURL».');
        const janela = window.open('', '_blank'); // abre já, dentro do gesto do utilizador, para o bloqueador de popups não o impedir
        return App.run(btn, async () => {
            const r = await fetch('/Reunioes/Programa', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ cookie: cookie, ano: App.$('#pgAno').value, mes: App.$('#pgMes').value, dirigente: App.$('#pgDir').value }) });
            if (!r.ok) { if (janela) janela.close(); notifyError(r.status === 401 ? 'A sessão do Hourglass expirou. Copie o pedido outra vez.' : (await r.text()) || 'Não foi possível gerar o programa.'); return; }
            const url = URL.createObjectURL(await r.blob());
            if (janela) janela.location.href = url; else location.href = url;
            App.$('#pgCookie').value = ''; App.modal('modalPrograma').close();
        }, 'Não foi possível gerar o programa.');
    });

</script>
<script>
    (function () {
        const iso = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        const seg = new Date(); seg.setDate(seg.getDate() - ((seg.getDay() + 6) % 7)); // segunda-feira desta semana
        const fim = new Date(seg); fim.setDate(fim.getDate() + 5 * 7 - 1);
        App.$('#hgDe').value = iso(seg); App.$('#hgAte').value = iso(fim);

        let prev = null;
        let mapa = {}; try { mapa = JSON.parse(localStorage.getItem('hgMapa') || '{}'); } catch (e) { }
        const postJson = async (url, corpo) => {
            const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(corpo) });
            if (!r.ok) throw new Error(await r.text());
            return r.json();
        };

        App.on('hgObter', btn => App.run(btn, async () => {
            const bruto = App.$('#hgCookie').value.trim(); if (!bruto) return App.campo('#hgCookie', 'Cole o pedido ou a cookie primeiro.');
            const cookie = App.extrairCookie(bruto);
            if (!/hglogin=/.test(cookie) || !/X-Hourglass-XSRF-Token=/.test(cookie)) return App.campo('#hgCookie', 'Não encontrei a sessão do Hourglass (hglogin e token XSRF). Copie um pedido «schedule» completo com «Copiar como cURL».');
            const r = await fetch('/Reunioes/HourglassPreview', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ cookie: cookie, de: App.$('#hgDe').value, ate: App.$('#hgAte').value }) });
            if (!r.ok) { notifyError(r.status === 401 ? 'A sessão do Hourglass expirou. Copie o pedido outra vez.' : (await r.text()) || 'Não foi possível obter os dados do Hourglass.'); return; }
            prev = await r.json(); App.$('#hgCookie').value = '';
            desenhar();
        }, 'Não foi possível obter os dados do Hourglass.'));

        function desenhar() {
            const cont = App.$('#hgPasso2'); cont.innerHTML = '';
            if (!prev.semanas.length) { cont.innerHTML = '<div class="empty-state"><strong>Sem reuniões neste intervalo</strong>Tente outras datas.</div>'; }
            const base = '<option value="0">— não importar —</option>';
            const opcoes = prev.tipos.map(t => '<option value="' + t.id + '">' + t.id + ' · ' + esc(t.descricao || t.adicional) + '</option>').join('');
            const mes = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
            const dia = iso => { const d = new Date(iso + 'T12:00:00'); return d.getDate() + ' ' + mes[d.getMonth()]; };
            const rotuloDia = (iso, nome) => nome + ' ' + dia(iso);
            prev.semanas.forEach((s, si) => {
                const el = document.createElement('section'); el.className = 'hg-semana'; el.dataset.i = si;
                const novos = s.itens.filter(i => i.tipoId === -1).length;
                el.innerHTML = '<header><label class="checkbox"><input type="checkbox" class="hg-on" checked> ' + esc(s.semana) + '</label>' +
                    '<span class="num">Fim de semana: ' + dia(s.sabado) + ' e ' + dia(s.domingo) + '</span>' +
                    (s.existe ? '<span class="tag is-warning">já existe: será substituída</span>' : '') + (novos ? '<span class="tag is-info">' + novos + ' tipo(s) a criar</span>' : '') + '</header>' +
                    '<table><thead><tr><th>Parte</th><th>Sala</th><th>Min.</th><th>Pessoa(s)</th><th>Tipo local</th></tr></thead><tbody></tbody></table>';
                const tb = App.$('tbody', el);
                s.itens.forEach((it, ii) => {
                    if (mapa[it.chave] > 0 && it.tipoId <= 0) it.tipoId = mapa[it.chave];
                    const tr = document.createElement('tr'); tr.dataset.i = ii;
                    tr.innerHTML = '<td>' + esc(it.titulo) + '</td><td>' + esc(it.sala) + '</td><td class="num">' + (it.minutos || '') + '</td><td>' +
                        it.pessoas.map(p => esc(p.pubId ? p.pubNome : p.nome) + (p.pubId ? '' : ' <span class="sem-par" title="Sem correspondência nos publicadores: fica só o nome">?</span>')).join(' | ') +
                        '</td><td><div class="select is-small"><select>' + base + '<option value="-1">Criar «' + esc(it.rotulo) + '»</option>' + opcoes + '</select></div></td>';
                    App.$('select', tr).value = it.tipoId; tb.appendChild(tr);
                });
                const extra = [];
                if (s.canticos.some(c => c > 0)) extra.push('<span>Cânticos: <b class="num">' + s.canticos.filter(c => c > 0).join(', ') + '</b></span>');
                if (s.discurso) extra.push('<span>Discurso <b>' + s.discurso.numero + '</b> ' + esc(s.discurso.tema) + ' · ' + esc(s.discurso.orador) + (s.discurso.congregacao && !s.discurso.pubId ? ' (' + esc(s.discurso.congregacao) + ')' : '') +
                    ' · <span class="select is-small"><select class="hg-data" aria-label="Dia do discurso"><option value="' + s.sabado + '"' + (s.discurso.data === s.sabado ? ' selected' : '') + '>' + rotuloDia(s.sabado, 'Sábado') + '</option><option value="' + s.domingo + '"' + (s.discurso.data === s.domingo ? ' selected' : '') + '>' + rotuloDia(s.domingo, 'Domingo') + '</option></select></span>' + (s.discurso.existe ? ' <span class="tag is-light">já registado: não será repetido</span>' : '') + '</span>');
                if (extra.length) { const d = document.createElement('div'); d.className = 'extra'; d.innerHTML = extra.join(''); el.appendChild(d); }
                cont.appendChild(el);
            });
            App.$('#hgPasso1').hidden = true; cont.hidden = false; App.$('#hgObter').hidden = true; App.$('#hgImportar').hidden = !prev.semanas.length;
        }
        const esc = t => String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        App.on('hgImportar', async btn => {
            // lê o estado do ecrã (seleção, tipos e datas editadas)
            App.$$('#hgPasso2 .hg-semana').forEach(el => {
                const s = prev.semanas[el.dataset.i]; s.importar = App.$('.hg-on', el).checked;
                App.$$('tbody tr', el).forEach(tr => { const it = s.itens[tr.dataset.i]; it.tipoId = +App.$('select', tr).value; if (it.tipoId > 0) mapa[it.chave] = it.tipoId; });
                const dt = App.$('.hg-data', el); if (dt && s.discurso) s.discurso.data = dt.value;
            });
            const n = prev.semanas.filter(s => s.importar).length; if (!n) { notifyError('Selecione pelo menos uma semana.'); return; }
            const subst = prev.semanas.filter(s => s.importar && s.existe).length;
            if (!await App.confirm({ title: 'Importar reuniões', text: 'Importar ' + n + ' semana(s)?' + (subst ? ' ' + subst + ' já existe(m) e será(ão) substituída(s), incluindo alterações feitas à mão.' : ''), ok: 'Importar', danger: false })) return;
            App.run(btn, async () => {
                try { localStorage.setItem('hgMapa', JSON.stringify(mapa)); } catch (e) { }
                const r = await postJson('/Reunioes/HourglassImportar', prev);
                notify(r.semanas + ' semana(s), ' + r.designacoes + ' designações e ' + r.discursos + ' discurso(s) importados.');
                setTimeout(() => location.reload(), 900); // a lista de reuniões é desta página
            }, 'Não foi possível importar as reuniões.');
        });
    })();
</script>
}
