@model IEnumerable<JW_Management.Models.Reuniao>
@{
    ViewData["Title"] = "Reuniões";
    var progresso = (Dictionary<string, (int Total, int Atribuidas)>)ViewBag.Progresso;
    (int Total, int Atrib) P(string stamp) => progresso.TryGetValue(stamp, out var v) ? (v.Total, v.Atribuidas) : (0, 0);
    var porAtribuir = Model.Sum(r => { var p = P(r.Stamp!); return p.Total - p.Atrib; });
    var completas = Model.Count(r => { var p = P(r.Stamp!); return p.Total > 0 && p.Total == p.Atrib; });
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Reuniões</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalHourglass">
                <span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Importar do Hourglass</span>
            </button>
            <a class="button is-info is-light" href="~/Reunioes/Programa">
                <span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>Programa e PDF</span>
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-calendar-days", "Semanas registadas", Model.Count().ToString(), "sTot", ""),
        ("fa-circle-check", "Completas", completas.ToString(), "sOk", "is-ok"),
        ("fa-user-clock", "Designações por atribuir", porAtribuir.ToString(), "sFalta", porAtribuir > 0 ? "is-warn" : "") })

    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar semana" aria-label="Pesquisar semanas">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar">
            <button type="button" class="chip" data-type="0" aria-pressed="true">Todas</button>
            <button type="button" class="chip" data-type="falta" aria-pressed="false">Por completar</button>
            <button type="button" class="chip" data-type="ok" aria-pressed="false">Completas</button>
        </div>
    </div>

    <div id="lista" class="items">
        @foreach (var item in Model)
        {
            var p = P(item.Stamp!);
            var pct = p.Total == 0 ? 0 : p.Atrib * 100 / p.Total;
            var ok = p.Total > 0 && p.Atrib == p.Total;
            <article class="item no-thumb" data-stamp="@item.Stamp" data-type="@(ok ? "ok" : "falta")" data-search="@item.SemanaReuniao">
                <div class="main">
                    <div class="name"><a href="~/Reunioes/Reuniao/@item.Stamp">@item.SemanaReuniao</a></div>
                    <div class="meta">
                        <span class="prog" title="@p.Atrib de @p.Total atribuídas"><span class="prog-bar"><i style="width:@pct%"></i></span></span>
                        <span class="num">@p.Atrib / @p.Total atribuídas</span>
                        @if (ok) { <span class="tag is-success">Completa</span> }
                        else if (p.Total == 0) { <span class="tag is-light">Sem designações</span> }
                    </div>
                </div>
                <div class="side">
                    <div class="acts">
                        <a class="button is-info" href="~/Reunioes/Reuniao/@item.Stamp"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span><span>Abrir</span></a>
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar @item.SemanaReuniao" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>
    <div id="vazio" class="empty-state" hidden>
        <span class="icon"><i class="fa-solid fa-calendar-days"></i></span>
        <strong>Não há semanas para mostrar</strong>
        Importe as reuniões do Hourglass.
    </div>
</div>

<div id="modalHourglass" class="modal" role="dialog" aria-modal="true" aria-labelledby="tHg" data-persist="1">
    <div class="modal-background"></div>
    <div class="modal-card is-wide">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tHg"><span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Importar reuniões do Hourglass</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div id="hgPasso1">
                <div id="hgBloco">
                <ol class="steps">
                    <li>Abra o <a href="https://app.hourglass-app.com/v2/page/app/scheduling/mm" target="_blank" rel="noopener">Hourglass</a> com a sessão iniciada (Agendamento, Reunião de meio de semana).</li>
                    <li>Prima <kbd>F12</kbd>, abra o separador <b>Rede</b> e recarregue a página.</li>
                    <li>Na lista de pedidos procure um cujo nome é um intervalo de datas (por exemplo <b>2026-11-01_2026-11-30</b>): botão direito, <b>Copiar</b>, <b>Copiar como cURL</b>, e cole abaixo.</li>
                </ol>
                <div class="field">
                    <label class="label" for="hgCookie">Pedido copiado (ou só a cookie)</label>
                    <textarea class="textarea" id="hgCookie" rows="3" spellcheck="false" autocomplete="off" placeholder="curl 'https://app.hourglass-app.com/...' -H 'Cookie: ...'"></textarea>
                    <p class="field-hint">Só se fazem leituras no Hourglass. A sessão fica guardada no servidor (só em memória) durante 6 horas.</p>
                </div>
                </div>
                <div class="form-grid">
                    <div class="field"><label class="label" for="hgDe">De</label><input type="date" class="input" id="hgDe"></div>
                    <div class="field"><label class="label" for="hgAte">Até</label><input type="date" class="input" id="hgAte"></div>
                </div>
            </div>
            <div id="hgPasso2" hidden></div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" id="hgObter" data-action="hgObter" data-submit><span class="icon"><i class="fa-solid fa-cloud-arrow-down"></i></span><span>Obter programa</span></button>
            <button type="button" class="button is-success" id="hgImportar" data-action="hgImportar" hidden><span class="icon"><i class="fa-solid fa-file-import"></i></span><span>Importar selecionadas</span></button>
        </footer>
    </div>
</div>



@section Scripts {
<script>
    App.filtro({
        lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio', semUrl: true,
        aoAplicar: v => App.stats({ sTot: v.length, sOk: v.filter(i => i.dataset.type === 'ok').length })
    });

    App.on('apagar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar semana', text: 'Apagar «' + App.$('.name', it).textContent.trim() + '» e todas as designações associadas?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Reunioes/Reuniao/', { id: it.dataset.stamp }); App.removeItem(it); notify('Semana apagada.'); },
            'Não foi possível apagar a semana.');
    });
</script>
<script>
    (function () {
        const iso = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        const seg = new Date(); seg.setDate(seg.getDate() - ((seg.getDay() + 6) % 7)); // segunda-feira desta semana
        const fim = new Date(seg); fim.setDate(fim.getDate() + 5 * 7 - 1);
        App.$('#hgDe').value = iso(seg); App.$('#hgAte').value = iso(fim);

        let prev = null; App.hgSessao('#hgBloco');
        let mapa = {}; try { mapa = JSON.parse(localStorage.getItem('hgMapa') || '{}'); } catch (e) { }
        const postJson = async (url, corpo) => {
            const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(corpo) });
            if (!r.ok) throw new Error(await r.text());
            return r.json();
        };

        App.on('hgObter', btn => App.run(btn, async () => {
            const cookie = App.hgCookie('#hgCookie'); if (cookie === null) return;
            const r = await fetch('/Reunioes/HourglassPreview', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ cookie: cookie, de: App.$('#hgDe').value, ate: App.$('#hgAte').value }) });
            if (!r.ok) { notifyError(r.status === 401 ? 'A sessão do Hourglass expirou. Cole o pedido outra vez.' : (await r.text()) || 'Não foi possível obter os dados do Hourglass.'); return; }
            prev = await r.json();
            desenhar();
        }, 'Não foi possível obter os dados do Hourglass.'));

        function desenhar() {
            const cont = App.$('#hgPasso2'); cont.innerHTML = '';
            if (!prev.semanas.length) { cont.innerHTML = '<div class="empty-state"><strong>Sem reuniões neste intervalo</strong>Tente outras datas.</div>'; }
            const base = '<option value="0">— não importar —</option>';
            const opcoes = prev.tipos.map(t => '<option value="' + t.id + '">' + t.id + ' · ' + esc(t.descricao || t.adicional) + '</option>').join('');
            prev.semanas.forEach((s, si) => {
                const el = document.createElement('section'); el.className = 'hg-semana'; el.dataset.i = si;
                const novos = s.itens.filter(i => i.tipoId === -1).length;
                el.innerHTML = '<header><label class="checkbox"><input type="checkbox" class="hg-on" checked> ' + esc(s.semana) + '</label>' +
                    (s.existe ? '<span class="tag is-warning">já existe: será substituída</span>' : '') + (novos ? '<span class="tag is-info">' + novos + ' tipo(s) a criar</span>' : '') + '</header>' +
                    '<table><thead><tr><th>Parte</th><th>Sala</th><th>Min.</th><th>Pessoa(s)</th><th>Tipo local</th></tr></thead><tbody></tbody></table>';
                const tb = App.$('tbody', el);
                s.itens.forEach((it, ii) => {
                    if (mapa[it.chave] > 0 && it.tipoId <= 0) it.tipoId = mapa[it.chave];
                    const tr = document.createElement('tr'); tr.dataset.i = ii;
                    tr.innerHTML = '<td>' + esc(it.titulo) + '</td><td>' + esc(it.sala) + '</td><td class="num">' + (it.minutos || '') + '</td><td>' +
                        it.pessoas.map(p => esc(p.pubId ? p.pubNome : p.nome) + (p.pubId ? '' : ' <span class="sem-par" title="Sem correspondência nos publicadores: fica só o nome">?</span>')).join(' | ') +
                        '</td><td><div class="select is-small"><select>' + base + '<option value="-1">Criar «' + esc(it.rotulo) + '»</option>' + opcoes + '</select></div></td>';
                    App.$('select', tr).value = it.tipoId; tb.appendChild(tr);
                });
                const extra = [];
                if (s.canticos.some(c => c > 0)) extra.push('<span>Cânticos: <b class="num">' + s.canticos.filter(c => c > 0).join(', ') + '</b></span>');
                if (extra.length) { const d = document.createElement('div'); d.className = 'extra'; d.innerHTML = extra.join(''); el.appendChild(d); }
                cont.appendChild(el);
            });
            App.$('#hgPasso1').hidden = true; cont.hidden = false; App.$('#hgObter').hidden = true; App.$('#hgImportar').hidden = !prev.semanas.length;
        }
        const esc = t => String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        App.on('hgImportar', async btn => {
            // lê o estado do ecrã (seleção, tipos e datas editadas)
            App.$$('#hgPasso2 .hg-semana').forEach(el => {
                const s = prev.semanas[el.dataset.i]; s.importar = App.$('.hg-on', el).checked;
                App.$$('tbody tr', el).forEach(tr => { const it = s.itens[tr.dataset.i]; it.tipoId = +App.$('select', tr).value; if (it.tipoId > 0) mapa[it.chave] = it.tipoId; });
            });
            const n = prev.semanas.filter(s => s.importar).length; if (!n) { notifyError('Selecione pelo menos uma semana.'); return; }
            const subst = prev.semanas.filter(s => s.importar && s.existe).length;
            if (!await App.confirm({ title: 'Importar reuniões', text: 'Importar ' + n + ' semana(s)?' + (subst ? ' ' + subst + ' já existe(m) e será(ão) substituída(s), incluindo alterações feitas à mão.' : ''), ok: 'Importar', danger: false })) return;
            App.run(btn, async () => {
                try { localStorage.setItem('hgMapa', JSON.stringify(mapa)); } catch (e) { }
                const r = await postJson('/Reunioes/HourglassImportar', prev);
                notify(r.semanas + ' semana(s) e ' + r.designacoes + ' designações importadas.');
                setTimeout(() => location.reload(), 900); // a lista de reuniões é desta página
            }, 'Não foi possível importar as reuniões.');
        });
    })();
</script>
}
