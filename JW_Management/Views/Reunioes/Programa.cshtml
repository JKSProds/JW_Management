@model JW_Management.Models.ProgramaPagina
@using System.Globalization
@using JW_Management.Models
@{
    ViewData["Title"] = "Programa";
    var pt = new CultureInfo("pt-PT");
    var mesAtual = new DateTime(Model.Ano, Model.Mes, 1);
    var ant = mesAtual.AddMonths(-1); var seg = mesAtual.AddMonths(1);
    var est = Model.Estado;
    string Dia(string iso) { var d = DateTime.ParseExact(iso, "yyyy-MM-dd", CultureInfo.InvariantCulture); var n = pt.DateTimeFormat.GetDayName(d.DayOfWeek); return char.ToUpper(n[0]) + n[1..] + " " + d.Day; }
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Programa de @ProgramaServico.NomeMes(Model.Mes) @Model.Ano</h1></div></div>
        <div class="head-actions">
            <a class="button btn-icon" href="~/Reunioes/Programa?ano=@ant.Year&mes=@ant.Month" aria-label="Mês anterior" title="Mês anterior"><i class="fa-solid fa-chevron-left"></i></a>
            <a class="button btn-icon" href="~/Reunioes/Programa?ano=@seg.Year&mes=@seg.Month" aria-label="Mês seguinte" title="Mês seguinte"><i class="fa-solid fa-chevron-right"></i></a>
            <button type="button" class="button" data-open="modalEmail" title="Enviar os programas deste mês por email">
                <span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar por email</span>
            </button>
            <a class="button" href="~/Reunioes" title="Designações por semana e importação das reuniões"><span class="icon"><i class="fa-solid fa-list"></i></span><span>Listagem</span></a>
            <button type="button" class="button is-info" data-open="modalSync">
                <span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>@(est.Semanas > 0 ? "Atualizar do Hourglass" : "Obter do Hourglass")</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-calendar-week", "Semanas guardadas", est.Semanas + " de " + est.SemanasEsperadas, "", est.Semanas >= est.SemanasEsperadas && est.Semanas > 0 ? "is-ok" : "is-warn"),
        ("fa-people-carry-box", "Serviço de campo", est.Campo ? "Guardado" : "Em falta", "", est.Campo ? "is-ok" : "is-warn"),
        ("fa-bullhorn", "Testemunho público", est.Testemunho ? "Guardado" : "Em falta", "", est.Testemunho ? "is-ok" : "is-warn"),
        ("fa-clock-rotate-left", "Última atualização", est.Atualizado?.ToString("dd/MM HH:mm") ?? "—", "", "") })

    @if (!est.Completo)
    {
        <div class="notice is-warn">
            <span class="icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <span>Ainda não há tudo guardado para este mês. Use «@(est.Semanas > 0 ? "Atualizar" : "Obter") do Hourglass» uma vez: depois os PDF geram-se sem pedir a cookie.</span>
        </div>
    }

    <div class="seg" role="tablist" aria-label="Programas">
        <button type="button" role="tab" id="tabProg" aria-controls="panProg" aria-selected="true">Reuniões</button>
        <button type="button" role="tab" id="tabCampo" aria-controls="panCampo" aria-selected="false">Serviço de campo</button>
        <button type="button" role="tab" id="tabTest" aria-controls="panTest" aria-selected="false">Testemunho público</button>
    </div>

    <section id="panProg" role="tabpanel" aria-labelledby="tabProg">
        <div class="toolbar">
            <div class="field" style="min-width:260px;flex:1">
                <label class="label" for="pgDir">Dirigente de A Sentinela por omissão</label>
                <div><input class="input is-small" id="pgDir" type="text" value="@ViewBag.DirigenteNome" placeholder="Escreva o nome do publicador" autocomplete="off"></div>
                <input type="hidden" id="pgDirId" value="@(ViewBag.DirigenteId > 0 ? ViewBag.DirigenteId.ToString() : "")">
            </div>
            <button type="button" class="button is-success" data-action="pdf" data-tipo="programa" @(Model.Programa == null ? "data-sem-dados" : "")><span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>PDF (horizontal)</span></button>
        </div>
        @if (Model.Programa == null)
        {
            <div class="empty-state"><span class="icon"><i class="fa-solid fa-calendar-week"></i></span><strong>Sem programa guardado para este mês</strong>Obtenha-o do Hourglass.</div>
        }
        else
        {
            <div class="prog-scroll">
                <table class="prog-tabela">
                    <thead><tr><th></th>@foreach (var s in Model.Programa.Semanas) { <th>@s.Titulo</th> }</tr></thead>
                    <tbody>
                    @foreach (var sec in Model.Programa.Secoes)
                    {
                        if (sec.Titulo != "") { <tr class="@(sec.Faixa ? "faixa" : "secao")"><th colspan="@(Model.Programa.Semanas.Count + 1)">@sec.Titulo</th></tr> }
                        foreach (var l in sec.Linhas)
                        {
                            <tr>
                                <th>@l.Rotulo</th>
                                @foreach (var s in Model.Programa.Semanas)
                                {
                                    var v = s.Valores.GetValueOrDefault(l.Id, "");
                                    var evL = new[] { "min1", "min2", "min3" }.Contains(l.Id) ? s.SemMeio : new[] { "std", "stl", "sto" }.Contains(l.Id) ? s.SemFim : new List<string>();
                                    <td class="@(evL.Count > 0 ? "evento" : "")">@(evL.Count > 0 && new[] { "min1", "std" }.Contains(l.Id) ? string.Join(" ", evL) : v)</td>
                                }
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section id="panCampo" role="tabpanel" aria-labelledby="tabCampo" hidden>
        <div class="toolbar">
            <span class="field-hint">Reuniões para o serviço de campo: dia, hora, local e dirigente.</span>
            <button type="button" class="button is-success" data-action="pdf" data-tipo="campo" @(Model.Campo == null ? "data-sem-dados" : "")><span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>PDF (vertical)</span></button>
        </div>
        @if (Model.Campo == null) { <div class="empty-state"><span class="icon"><i class="fa-solid fa-people-carry-box"></i></span><strong>Sem serviço de campo guardado</strong>Obtenha-o do Hourglass.</div> }
        else if (!Model.Campo.Any()) { <div class="empty-state"><strong>Sem reuniões de serviço neste mês</strong></div> }
        else
        {
            @foreach (var sem in Model.Campo.GroupBy(e => { var d = DateTime.ParseExact(e.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture); return d.AddDays(-(((int)d.DayOfWeek + 6) % 7)); }).OrderBy(g => g.Key))
            {
                var fimSem = sem.Key.AddDays(6);
                <h2 class="group-title">Semana de @sem.Key.Day @(sem.Key.Month != fimSem.Month ? "de " + ProgramaServico.NomeMes(sem.Key.Month) + " " : "")a @fimSem.Day de @ProgramaServico.NomeMes(fimSem.Month)</h2>
                <div class="items">
                @foreach (var e in sem.OrderBy(x => x.Data).ThenBy(x => x.Hora))
                {
                    var fds = DateTime.ParseExact(e.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture).DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    <article class="item no-thumb @(fds ? "is-fds" : "")">
                        <div class="main"><div class="name">@Dia(e.Data)</div><div class="meta"><span class="num">@e.Hora</span><span><i class="fa-solid fa-location-dot fa-xs"></i> @e.Local</span></div></div>
                        <div class="side"><span class="tag @(e.Dirigente == "" ? "is-light" : "is-info")">@(e.Dirigente == "" ? "Sem dirigente" : e.Dirigente)</span></div>
                    </article>
                }
                </div>
            }
        }
    </section>

    <section id="panTest" role="tabpanel" aria-labelledby="tabTest" hidden>
        <div class="toolbar">
            <span class="field-hint">Turnos por local, com os publicadores de cada turno.</span>
            <button type="button" class="button is-success" data-action="pdf" data-tipo="testemunho" @(Model.Testemunho == null ? "data-sem-dados" : "")><span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>PDF (vertical)</span></button>
        </div>
        @if (Model.Testemunho == null) { <div class="empty-state"><span class="icon"><i class="fa-solid fa-bullhorn"></i></span><strong>Sem testemunho público guardado</strong>Obtenha-o do Hourglass.</div> }
        else if (!Model.Testemunho.Any()) { <div class="empty-state"><strong>Sem turnos neste mês</strong></div> }
        else
        {
            foreach (var local in Model.Testemunho.GroupBy(t => t.Local).OrderBy(g => g.Key))
            {
                <h2 class="group-title">@(local.Key == "" ? "Sem local" : local.Key)</h2>
                <div class="items">
                @foreach (var t in local.OrderBy(x => x.Data).ThenBy(x => x.Inicio))
                {
                    <article class="item no-thumb">
                        <div class="main"><div class="name">@Dia(t.Data)</div><div class="meta"><span class="num">@t.Inicio – @t.Fim</span></div></div>
                        <div class="side">@(t.Pessoas.Count == 0 ? Html.Raw("<span class=\"tag is-light\">por atribuir</span>") : Html.Raw(string.Join(" ", t.Pessoas.Select(p => "<span class=\"tag is-info\">" + System.Net.WebUtility.HtmlEncode(p) + "</span>"))))</div>
                    </article>
                }
                </div>
            }
        }
    </section>
</div>

<div id="modalEmail" class="modal" role="dialog" aria-modal="true" aria-labelledby="tEm" data-persist="1">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tEm"><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar programas de @ProgramaServico.NomeMes(Model.Mes) @Model.Ano por email</span></p>
            <button type="button" class="button delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4">Cada publicador escolhido recebe um email com os programas escolhidos em PDF, tal como estão guardados.</p>
            <div class="field">
                <label class="label">Programas</label>
                <label class="checkbox" style="display:block"><input type="checkbox" class="em-tipo" value="programa" @(Model.Programa == null ? "disabled" : "")> Reuniões@(Model.Programa == null ? " (sem dados)" : "")</label>
                <label class="checkbox" style="display:block"><input type="checkbox" class="em-tipo" value="campo" @(Model.Campo == null ? "disabled" : "")> Serviço de campo@(Model.Campo == null ? " (sem dados)" : "")</label>
                <label class="checkbox" style="display:block"><input type="checkbox" class="em-tipo" value="testemunho" @(Model.Testemunho == null ? "disabled" : "")> Testemunho público@(Model.Testemunho == null ? " (sem dados)" : "")</label>
            </div>
            <div class="field">
                <label class="label" for="emBusca">Publicadores com email <span class="tag is-light ml-1" id="emN">nenhum escolhido</span></label>
                <div><input type="text" class="input" id="emBusca" placeholder="Escreva o nome do publicador"></div>
                <div class="tags" id="emFichas" style="margin-top:.6rem"></div>
                <button type="button" class="button is-small is-ghost" data-action="emTodos">Adicionar todos</button>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="emailProgramas" data-submit><span class="icon"><i class="fa-solid fa-paper-plane"></i></span><span>Enviar</span></button>
        </footer>
    </div>
</div>

<div id="modalSync" class="modal" role="dialog" aria-modal="true" aria-labelledby="tSy" data-persist="1">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tSy"><span class="icon"><i class="fa-solid fa-hourglass-half"></i></span><span>Obter @ProgramaServico.NomeMes(Model.Mes) @Model.Ano do Hourglass</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4">Lê as reuniões (programa e designações), o serviço de campo e o testemunho público deste mês (só leitura) e guarda-os. Depois, os PDF geram-se sem pedir a cookie.</p>
            <div class="buttons has-addons" role="group" aria-label="Origem dos dados">
                <button type="button" class="button is-info is-selected" data-action="hgModo" data-modo="sessao" aria-pressed="true">Sessão (token)</button>
                <button type="button" class="button" data-action="hgModo" data-modo="pacote" aria-pressed="false">Exportação (colar dados)</button>
            </div>
            <p class="field-hint" id="pgModoDica">Cada vez que prime o botão lê os dados mais recentes do Hourglass.</p>
            <div id="pgPacote" hidden>
            <ol class="steps">
                <li>No Hourglass, com a sessão iniciada, execute o atalho de exportação (Partilhar, e escolha o atalho).</li>
                <li>Cole abaixo o conteúdo copiado. Começa por <code>{"hgdata":</code>.</li>
            </ol>
            <div class="field">
                <label class="label" for="pgPacoteTxt">Exportação do atalho</label>
                <textarea class="textarea" id="pgPacoteTxt" rows="3" spellcheck="false" autocomplete="off" placeholder='{"hgdata":2,...'></textarea>
                <p class="field-hint">Não fica guardada. Usa sempre exatamente estes dados e tem de ser colada de cada vez.</p>
            </div>
            </div>
            <div id="pgBloco">
            <ol class="steps">
                <li>Abra o <a href="https://app.hourglass-app.com/v2/page/app/scheduling/mm" target="_blank" rel="noopener">Hourglass</a> com a sessão iniciada, prima <kbd>F12</kbd> e abra o separador <b>Rede</b>.</li>
                <li>Num pedido cujo nome é um intervalo de datas (por exemplo <b>2026-11-01_2026-11-30</b>): botão direito, <b>Copiar</b>, <b>Copiar como cURL</b>, e cole abaixo.</li>
            </ol>
            <div class="field">
                <label class="label" for="pgCookie">Pedido copiado (ou só a cookie)</label>
                <textarea class="textarea" id="pgCookie" rows="3" spellcheck="false" autocomplete="off" placeholder="curl 'https://app.hourglass-app.com/...' -H 'Cookie: ...'"></textarea>
                <p class="field-hint">A sessão fica guardada no servidor (só em memória) durante 6 horas, para não ter de colar o pedido outra vez.</p>
            </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="sync" data-submit><span class="icon"><i class="fa-solid fa-cloud-arrow-down"></i></span><span>Obter e guardar</span></button>
        </footer>
    </div>
</div>

@section Scripts {
<script>
    const ano = @Model.Ano, mes = @Model.Mes, jaGuardado = @(est.Semanas > 0 ? "true" : "false");
    // Dirigente por omissão: publicador da congregação, guardado na base de dados (vale para todos os utilizadores e dispositivos).
    const pesqDir = App.pesquisaPublicador('#pgDir', '#pgDirId', false);
    let dirGuardado = App.$('#pgDirId').value;
    App.$('#pgDirId').addEventListener('change', async e => {
        if (e.target.value === dirGuardado) return;
        try { await App.api('POST', '/Reunioes/ProgramaDirigente', { id: e.target.value || 0 }); dirGuardado = e.target.value; notify(e.target.value ? 'Dirigente guardado.' : 'Dirigente removido.'); }
        catch (x) { notifyError('Não foi possível guardar o dirigente.'); }
    });
    App.$('#pgDir').addEventListener('blur', () => { if (!App.$('#pgDir').value.trim() && dirGuardado) { App.$('#pgDirId').value = ''; App.$('#pgDirId').dispatchEvent(new Event('change')); } });

    // PDF: abre diretamente se o mês já está guardado; senão pede primeiro os dados ao Hourglass
    App.on('pdf', btn => {
        if (btn.hasAttribute('data-sem-dados')) { notify('Ainda não há dados deste mês: obtenha-os do Hourglass.'); App.modal('modalSync').open(); return; }
        const q = new URLSearchParams({ tipo: btn.dataset.tipo, ano: ano, mes: mes });
        window.open('/Reunioes/ProgramaPdf?' + q, '_blank');
    });

    App.hgSessao('#pgBloco');
    const origem = App.hgOrigem({ bloco: '#pgBloco', pacote: '#pgPacote', pacoteTxt: '#pgPacoteTxt', cookie: '#pgCookie', dica: '#pgModoDica' });


    // ---------- Enviar programas por email ----------
    // A mesma pesquisa de publicadores em todos os ecrãs; nada vem escolhido por omissão.
    const emPub = App.pesquisaPublicadores({
        input: '#emBusca', fichas: '#emFichas', soComEmail: true,
        aoMudar: n => { App.$('#emN').textContent = n ? n + ' escolhido(s)' : 'nenhum escolhido'; }
    });
    App.on('emTodos', btn => App.run(btn, () => emPub.adicionarTodos(), 'Não foi possível carregar os publicadores.'));
    App.on('emailProgramas', btn => App.run(btn, async () => {
        const tipos = App.$$('.em-tipo').filter(c => c.checked && !c.disabled).map(c => c.value);
        const ids = emPub.ids();
        if (!tipos.length) { notifyError('Escolha pelo menos um programa.'); return; }
        if (!ids.length) { notifyError('Escolha pelo menos um publicador.'); return; }
        if (!await App.confirm({ title: 'Enviar programas', text: 'Enviar ' + tipos.length + ' programa(s) por email a ' + ids.length + ' publicador(es)?', ok: 'Enviar' })) return;
        const r = await App.api('POST', '/Reunioes/ProgramaEnviar', { ano: ano, mes: mes, tipos: tipos.join(','), ids: ids.join(',') });
        if (r.enviados === r.total) { App.modal('modalEmail').close(); emPub.limpar(); App.$$('.em-tipo').forEach(c => { c.checked = false; }); notify('Programas enviados a ' + r.total + ' publicador(es).'); }
        else if (r.enviados === 0) notifyError('Não foi possível enviar. Confirme o email da congregação em Configuração.');
        else notifyError('Enviados ' + r.enviados + ' de ' + r.total + '. Os restantes falharam: consulte os registos do servidor.');
    }, 'Não foi possível enviar os programas.'));

    App.on('sync', btn => App.run(btn, async () => {
        const cookie = origem.obter(); if (cookie === null) return;
        if (jaGuardado && !await App.confirm({ title: 'Substituir o mês guardado', text: 'O programa e as designações das reuniões de @ProgramaServico.NomeMes(Model.Mes) @Model.Ano já estão guardados. Obter do Hourglass substitui-os pelos dados atuais.', ok: 'Substituir', danger: false })) return;
        const r = await fetch('/Reunioes/ProgramaSincronizar', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ cookie: cookie, ano: ano, mes: mes }) });
        if (!r.ok) { notifyError(r.status === 401 ? 'A sessão do Hourglass expirou. Cole o pedido outra vez.' : (await r.text()) || 'Não foi possível obter os dados do Hourglass.'); return; }
        // Importa também as designações das reuniões (páginas de Reuniões), com o mesmo pedido: a exportação não fica guardada.
        const iso = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        const primeira = new Date(ano, mes - 1, 1), seg = new Date(primeira); seg.setDate(seg.getDate() - ((seg.getDay() + 6) % 7));
        let ultima = seg; for (let d = new Date(seg); d.getMonth() === mes - 1; d.setDate(d.getDate() + 7)) ultima = new Date(d);
        const fim = new Date(ultima); fim.setDate(fim.getDate() + 6);
        const rp = await fetch('/Reunioes/HourglassPreview', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ cookie: cookie, de: iso(seg), ate: iso(fim) }) });
        if (!rp.ok) { notifyError('Programa guardado, mas as designações das reuniões não foram importadas: ' + ((await rp.text()) || 'erro do Hourglass.')); return; }
        const prev = await rp.json();
        let mapa = {}; try { mapa = JSON.parse(localStorage.getItem('hgMapa') || '{}'); } catch (e) { }
        prev.semanas.forEach(s => { s.importar = true; s.itens.forEach(it => { if (mapa[it.chave] > 0 && it.tipoId <= 0) it.tipoId = mapa[it.chave]; }); });
        const ri = await fetch('/Reunioes/HourglassImportar', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(prev) });
        if (!ri.ok) { notifyError('Programa guardado, mas as designações das reuniões não foram importadas: ' + ((await ri.text()) || 'erro.')); return; }
        origem.limpar(); notify('Programa e reuniões guardados.'); setTimeout(() => location.reload(), 700);
    }, 'Não foi possível obter os dados do Hourglass.'));
</script>
}
