@model IEnumerable<JW_Management.Models.Reuniao>
@{
    ViewData["Title"] = "Calendário";
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Calendário das reuniões</h1></div></div>
        <div class="head-actions">
            <a class="button is-info is-light" href="~/Reunioes">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Reuniões</span>
            </a>
        </div>
    </div>
    <div class="panel-card"><div id="gstc"></div></div>
</div>

@section Scripts {
@* O GSTC só é usado aqui; noutras páginas dava erro de sintaxe no Safari. *@
<script src="https://cdn.jsdelivr.net/npm/gantt-schedule-timeline-calendar"></script>
<script>
    // Tema do gráfico: o GSTC não segue o tema escuro da aplicação (cores próprias).
    const config = {};
    const state = GSTC.api.stateFromConfig(config);
    GSTC({ element: document.getElementById('gstc'), state });
</script>
}
