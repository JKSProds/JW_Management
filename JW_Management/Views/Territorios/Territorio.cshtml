@model JW_Management.Models.Territorio
@{
    ViewData["Title"] = "Território";
    var movimentos = Model.Movimentos ?? new();
    var anexos = Model.Anexos ?? new();
    var ult = Model.UltimoMovimento;
    var livre = ult?.Publicador == null || ult.Publicador.Id == 0;
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>@Model.Id · @Model.Nome</h1></div></div>
        <div class="head-actions">
            <button type="button" class="button is-info is-light" data-open="modalAnexos">
                <span class="icon"><i class="fa-solid fa-paperclip"></i></span><span>Anexos (<span id="nAnexos">@anexos.Count</span>)</span>
            </button>
            <a class="button is-info is-light" href="~/Territorios">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Territórios</span>
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-user-check", "Estado", livre ? "Disponível" : "Atribuído", "", livre ? "is-ok" : Model.CorEstado is "danger" ? "is-bad" : Model.CorEstado is "warning" ? "is-warn" : ""),
        ("fa-user", livre ? "Último publicador" : "Com o publicador", livre ? (string.IsNullOrEmpty(ult?.Stamp) ? "—" : ult?.Publicador?.Nome ?? "—") : ult!.Publicador!.Nome ?? "—", "", ""),
        ("fa-hourglass-half", "Último movimento", string.IsNullOrEmpty(ult?.Stamp) ? "—" : ((int)(DateTime.Now - ult!.DataMovimento).TotalDays) + " dia(s)", "", ""),
        ("fa-clock-rotate-left", "Movimentos", movimentos.Count.ToString(), "", "") })

    <div class="seg" role="tablist" aria-label="Secções do território">
        <button type="button" role="tab" id="tabDados" aria-controls="panDados" aria-selected="true">Dados</button>
        <button type="button" role="tab" id="tabMov" aria-controls="panMov" aria-selected="false">Movimentos<span class="count">@movimentos.Count</span></button>
    </div>

    <section id="panDados" role="tabpanel" aria-labelledby="tabDados">
        <form method="post" id="frmTerritorio" class="panel-card">
            <input type="hidden" asp-for="Stamp">
            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="Id">Número</label>
                    <input type="text" class="input" asp-for="Id">
                </div>
                <div class="field">
                    <label class="label" asp-for="Nome">Nome</label>
                    <input type="text" class="input" asp-for="Nome">
                </div>
                <div class="field">
                    <label class="label" asp-for="Dificuldade">Dificuldade</label>
                    <div class="select is-fullwidth">
                        <select asp-for="Dificuldade">
                            <option value="0">Fácil</option>
                            <option value="1">Moderado</option>
                            <option value="2">Difícil</option>
                        </select>
                    </div>
                </div>
                <div class="field span-all">
                    <label class="label" asp-for="Url">Endereço (URL)</label>
                    <div class="input-action">
                        <div class="control"><input type="text" class="input" asp-for="Url" id="txtURLTerritorio"></div>
                        @if (!string.IsNullOrEmpty(Model.Url))
                        {
                            <a class="button btn-icon" href="@Model.Url" target="_blank" rel="noopener" aria-label="Abrir endereço" title="Abrir endereço"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                        }
                        <button type="button" class="button btn-icon" data-action="lerQr" aria-label="Ler código QR" title="Ler código QR"><i class="fa-solid fa-qrcode"></i></button>
                    </div>
                </div>
                <div class="field span-all">
                    <label class="label" asp-for="Descricao">Descrição</label>
                    <textarea rows="4" class="textarea" asp-for="Descricao"></textarea>
                </div>
            </div>
            <div class="mt-5">
                <button class="button is-success" type="submit" id="btnGuardar">
                    <span class="icon"><i class="fa-regular fa-floppy-disk"></i></span><span>Guardar alterações</span>
                </button>
            </div>
        </form>
    </section>

    <section id="panMov" role="tabpanel" aria-labelledby="tabMov" hidden>
        @if (!movimentos.Any())
        {
            <div class="empty-state"><span class="icon"><i class="fa-solid fa-clock-rotate-left"></i></span><strong>Sem movimentos</strong>Este território ainda não foi atribuído.</div>
        }
        else
        {
            <div class="items">
                @foreach (var item in movimentos)
                {
                    var saida = item.Tipo == JW_Management.Models.TipoMovimentoTerritorio.SAIDA;
                    <article class="item no-thumb">
                        <div class="main">
                            <div class="name">@item.Publicador!.Nome</div>
                            <div class="meta"><span class="num">@item.DataMovimento.ToString("dd/MM/yyyy")</span></div>
                        </div>
                        <div class="side"><span class="tag @(saida ? "is-success" : "is-info")">@(saida ? "Devolvido" : "Levantado")</span></div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<div id="modalAnexos" class="modal" role="dialog" aria-modal="true" aria-labelledby="tAnx">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tAnx"><span class="icon"><i class="fa-solid fa-paperclip"></i></span><span>Anexos</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <form action="/Territorios/Anexo" method="POST" class="dropzone" id="frmAnexos">
                <input type="hidden" name="id" value="@Model.Stamp">
                <div class="dz-message needsclick">Largue aqui os anexos ou toque para escolher</div>
            </form>
            <div id="anexosLista" class="items mt-4">
                @foreach (var a in anexos)
                {
                    <article class="item no-thumb" data-stamp="@a.Stamp">
                        <div class="main"><div class="name">@a.Descricao</div></div>
                        <div class="side">
                            <div class="acts">
                                <a class="button btn-icon" href="@Url.Action("Anexo", "Territorios", new { id = a.Stamp })" target="_blank" rel="noopener" aria-label="Abrir anexo" title="Abrir"><i class="fa-solid fa-eye"></i></a>
                                <button type="button" class="button btn-icon is-danger-hover" data-action="apagarAnexo" aria-label="Apagar anexo" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>
                    </article>
                }
                @if (!anexos.Any()) { <p class="field-hint" id="semAnexos">Ainda não há anexos.</p> }
            </div>
        </section>
        <footer class="modal-card-foot"><button type="button" class="button is-info" data-close>Fechar</button></footer>
    </div>
</div>

<partial name="_ModalQr" />

@section Scripts {
<script>
    // Guardar sem recarregar a página.
    App.$('#frmTerritorio').addEventListener('submit', e => {
        e.preventDefault();
        App.run(App.$('#btnGuardar'), async () => {
            await App.api('POST', location.pathname, Object.fromEntries(new FormData(e.target)));
            notify('Dados guardados.');
        }, 'Não foi possível guardar os dados.');
    });

    App.on('lerQr', () => App.qr(t => App.$('#txtURLTerritorio').value = t));

    // Anexos: a lista atualiza-se sozinha depois de cada envio ou remoção.
    async function atualizarAnexos() {
        await App.refresh('#anexosLista');
        App.$('#nAnexos').textContent = App.$$('#anexosLista .item').length;
    }
    document.addEventListener('DOMContentLoaded', () => {
        const dz = Dropzone.forElement('#frmAnexos');
        dz.on('queuecomplete', () => { atualizarAnexos(); dz.removeAllFiles(true); });
        dz.on('success', () => notify('Anexo guardado.'));
    });

    App.on('apagarAnexo', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar anexo', text: 'Apagar «' + App.$('.name', it).textContent + '»?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Territorios/Anexo/' + it.dataset.stamp); await atualizarAnexos(); notify('Anexo apagado.'); },
            'Não foi possível apagar o anexo.');
    });
</script>
}
