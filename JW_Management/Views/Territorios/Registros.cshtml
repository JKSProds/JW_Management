@model IEnumerable<JW_Management.Models.RegistroTerritorio>
@{
    ViewData["Title"] = "Territórios - Registos";
    bool EmCurso(JW_Management.Models.RegistroTerritorio r) => r.Saida.DataMovimento == DateTime.MinValue;
}

<div class="container">
    <div class="page-head">
        <div class="head-title"><div><h1>Registos de territórios</h1></div></div>
        <div class="head-actions">
            <a class="button is-info is-light" href="~/Territorios">
                <span class="icon"><i class="fa-solid fa-arrow-left"></i></span><span>Territórios</span>
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-clock-rotate-left", "Registos", Model.Count().ToString(), "sTot", ""),
        ("fa-user-check", "Em curso", Model.Count(EmCurso).ToString(), "sCurso", ""),
        ("fa-circle-check", "Concluídos", Model.Count(r => !EmCurso(r)).ToString(), "sFim", "is-ok") })

    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar por território ou publicador" aria-label="Pesquisar registos">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar por estado">
            <button type="button" class="chip" data-type="0" aria-pressed="true">Todos</button>
            <button type="button" class="chip" data-type="curso" aria-pressed="false">Em curso</button>
            <button type="button" class="chip" data-type="fim" aria-pressed="false">Concluídos</button>
        </div>
    </div>

    <div id="lista" class="items">
        @foreach (var item in Model)
        {
            var curso = EmCurso(item);
            var tom = curso ? (item.CorEstado == "danger" ? "tone-bad" : item.CorEstado == "warning" ? "tone-warn" : "") : "";
            <article class="item no-thumb @tom" data-type="@(curso ? "curso" : "fim")" data-entrada="@item.Entrada.Stamp" data-saida="@item.Saida.Stamp"
                     data-label="@item.Territorio.Id - @item.Territorio.Nome" data-search="@item.Territorio.Id @item.Territorio.Nome @item.Entrada.Publicador.Nome">
                <div class="main">
                    <div class="name"><span class="ref-tag id-badge">@item.Territorio.Id</span> @item.Territorio.Nome</div>
                    <div class="meta">
                        <span><i class="fa-solid fa-user fa-xs"></i> @item.Entrada.Publicador.Nome</span>
                        <span class="num">Levantado a @item.Entrada.DataMovimento.ToString("dd/MM/yyyy")</span>
                        <span class="num">@(curso ? "Ainda por devolver" : "Devolvido a " + item.Saida.DataMovimento.ToString("dd/MM/yyyy"))</span>
                        @if (!string.IsNullOrWhiteSpace(item.Descricao)) { <span>@item.Descricao</span> }
                    </div>
                </div>
                <div class="side">
                    <div class="acts">
                        <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar registo" title="Apagar registo"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                </div>
            </article>
        }
    </div>

    <div id="vazio" class="empty-state" @(Model.Any() ? "hidden" : "")>
        <span class="icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
        <strong>Não foram encontrados registos</strong>
        Os levantamentos e devoluções de territórios aparecem aqui.
    </div>
</div>

@section Scripts {
<script>
    App.filtro({
        lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio',
        aoAplicar: v => App.stats({ sTot: v.length, sCurso: v.filter(i => i.dataset.type === 'curso').length, sFim: v.filter(i => i.dataset.type === 'fim').length })
    });

    App.on('apagar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar registo', text: 'Apagar o registo de «' + it.dataset.label + '»? Fica como se este território nunca tivesse sido levantado. Esta ação é irreversível.', ok: 'Apagar' })) return;
        App.run(btn, async () => {
            await App.api('DELETE', '/Territorios/Registros/', { stampentrada: it.dataset.entrada, stampsaida: it.dataset.saida });
            App.removeItem(it); notify('Registo apagado.');
        }, 'Não foi possível apagar o registo.');
    });
</script>
}
