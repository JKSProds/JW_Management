@model IEnumerable<JW_Management.Models.Territorio>
@{
    ViewData["Title"] = "Territórios";
    var publicadores = ((IEnumerable<SelectListItem>)ViewBag.Publicadores).ToList();

    bool Livre(JW_Management.Models.Territorio t) => t.UltimoMovimento?.Publicador == null || t.UltimoMovimento.Publicador.Id == 0;
    bool Atencao(JW_Management.Models.Territorio t) => t.UltimoMovimento != null && t.CorEstado is "danger" or "warning";
    var livres = Model.Count(Livre);
    var atencao = Model.Count(t => !Livre(t) && Atencao(t));
}

<div class="container">
    <div class="page-head">
        <div class="head-title">
            <div><h1>Territórios</h1></div>
        </div>
        <div class="head-actions">
            <button type="button" class="button is-info" data-open="modalNovo">
                <span class="icon"><i class="fa-solid fa-map-location-dot"></i></span><span>Novo território</span>
            </button>
            <a class="button is-info is-light" href="~/Territorios/Formulario">
                <span class="icon"><i class="fa-solid fa-file-pdf"></i></span><span>Formulário S-13</span>
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Stats", new[] {
        ("fa-map", "Territórios", Model.Count().ToString(), "sTot", ""),
        ("fa-box-open", "Disponíveis", livres.ToString(), "sLivre", "is-ok"),
        ("fa-user-check", "Atribuídos", (Model.Count() - livres).ToString(), "sAtr", ""),
        ("fa-hourglass-half", "Atribuídos há mais de 90 dias", atencao.ToString(), "sAt", atencao > 0 ? "is-warn" : "") })

    <div class="toolbar">
        <div class="control has-icons-left search">
            <input type="search" class="input" id="filtro" placeholder="Pesquisar por número, nome ou publicador" value="@ViewData["filtro"]" aria-label="Pesquisar territórios">
            <span class="icon is-left"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div class="chips" id="chips" role="group" aria-label="Filtrar por estado">
            <button type="button" class="chip" data-type="0" aria-pressed="true">Todos</button>
            <button type="button" class="chip" data-type="livre" aria-pressed="false">Disponíveis</button>
            <button type="button" class="chip" data-type="atribuido" aria-pressed="false">Atribuídos</button>
            <button type="button" class="chip" data-type="atencao" aria-pressed="false">Há mais de 90 dias</button>
        </div>
    </div>

    <div id="lista" class="items">
            @foreach (var item in Model)
            {
                var livre = Livre(item);
                var pub = livre ? "" : item.UltimoMovimento!.Publicador!.Nome;
                var tom = livre || item.UltimoMovimento == null ? "" : item.CorEstado == "danger" ? "tone-bad" : item.CorEstado == "warning" ? "tone-warn" : "";
                var estado = livre ? "livre" : "atribuido" + (Atencao(item) ? " atencao" : "");
                <article class="item no-thumb @tom" data-stamp="@item.Stamp" data-type="@estado" data-livre="@(livre ? 1 : 0)"
                         data-pub="@(livre ? 0 : item.UltimoMovimento!.Publicador!.Id)" data-label="@item.Id - @item.Nome [@item.Dificuldade]"
                         data-search="@item.Id @item.Nome @pub">
                    <div class="main">
                        <div class="name"><span class="ref-tag id-badge">@item.Id</span> @item.Nome</div>
                        <div class="meta">
                            <span class="diff diff-@item.Dificuldade">@(item.Dificuldade switch { JW_Management.Models.DificuldadeTerritorio.FACIL => "Fácil", JW_Management.Models.DificuldadeTerritorio.MODERADO => "Moderado", _ => "Difícil" })</span>
                            @if (livre)
                            {
                                <span>Disponível</span>
                                @if (!string.IsNullOrEmpty(item.UltimoMovimento?.DataDescritiva)) { <span>@item.UltimoMovimento!.DataDescritiva</span> }
                            }
                            else
                            {
                                <span><i class="fa-solid fa-user fa-xs"></i> @pub</span>
                                <span>@item.UltimoMovimento!.DataDescritiva</span>
                            }
                        </div>
                    </div>
                    <div class="side">
                        <div class="acts">
                            @if (livre)
                            {
                                <button type="button" class="button is-info" data-action="atribuir"><span class="icon"><i class="fa-solid fa-user-check"></i></span><span>Atribuir</span></button>
                            }
                            else
                            {
                                <button type="button" class="button is-success" data-action="devolver"><span class="icon"><i class="fa-solid fa-rotate-left"></i></span><span>Devolver</span></button>
                            }
                            <a class="button btn-icon" href="~/Territorios/Territorio/@item.Stamp" aria-label="Abrir @item.Nome" title="Abrir ficha"><i class="fa-solid fa-pen"></i></a>
                            <button type="button" class="button btn-icon is-danger-hover" data-action="apagar" aria-label="Apagar @item.Nome" title="Apagar"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                </article>
            }
    </div>

    <div id="vazio" class="empty-state" hidden>
        <span class="icon"><i class="fa-solid fa-map"></i></span>
        <strong>Não foram encontrados territórios</strong>
        Experimente outra pesquisa ou outro filtro.
    </div>
</div>

<div id="modalNovo" class="modal" role="dialog" aria-modal="true" aria-labelledby="tNovo">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tNovo"><span class="icon"><i class="fa-solid fa-map-location-dot"></i></span><span>Novo território</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <div class="form-grid">
                <div class="field">
                    <label class="label" for="txtIdTerritorio">Número</label>
                    <input type="text" class="input" id="txtIdTerritorio">
                </div>
                <div class="field">
                    <label class="label" for="txtNomeTerritorio">Nome</label>
                    <input type="text" class="input" id="txtNomeTerritorio">
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtDificuldadeTerritorio">Dificuldade</label>
                <div class="select is-fullwidth">
                    <select id="txtDificuldadeTerritorio">
                        <option value="1">Fácil</option>
                        <option value="2">Moderado</option>
                        <option value="3">Difícil</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtDescricaoTerritorio">Descrição</label>
                <textarea class="textarea" rows="3" id="txtDescricaoTerritorio"></textarea>
            </div>
            <div class="field">
                <label class="label" for="txtURLTerritorio">Endereço (URL)</label>
                <div class="input-action">
                    <div class="control"><input type="text" class="input" id="txtURLTerritorio"></div>
                    <button type="button" class="button btn-icon" data-action="lerQr" aria-label="Ler código QR" title="Ler código QR"><i class="fa-solid fa-qrcode"></i></button>
                </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-close>Cancelar</button>
            <button type="button" class="button is-info" data-action="criar" data-submit><span class="icon"><i class="fa-solid fa-check"></i></span><span>Criar</span></button>
        </footer>
    </div>
</div>

<div id="modalAtribuir" class="modal" role="dialog" aria-modal="true" aria-labelledby="tAtr">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tAtr"><span class="icon"><i class="fa-solid fa-user-check"></i></span><span>Atribuir território</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4" id="atrNome"></p>
            <div class="field">
                <label class="label" for="txtIdPublicador">Publicador</label>
                <div class="select is-fullwidth">
                    <select id="txtIdPublicador">
                        <option value="" disabled selected>Escolha o publicador…</option>
                        @foreach (var p in publicadores) { <option value="@p.Value">@p.Text</option> }
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="label" for="txtData">Data</label>
                <input type="date" class="input" id="txtData">
            </div>
            <div class="form-grid">
                <div class="field">
                    <label class="label" for="txtEmailPublicador">Email</label>
                    <input type="email" class="input" id="txtEmailPublicador" autocomplete="off">
                </div>
                <div class="field">
                    <label class="label" for="txtTelemovelPublicador">Telemóvel</label>
                    <input type="tel" class="input" id="txtTelemovelPublicador" autocomplete="off">
                </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-action="movimento" data-tipo="1" data-envio="nenhum">Só atribuir</button>
            <button type="button" class="button is-info is-light" data-action="movimento" data-tipo="1" data-envio="sms"><span class="icon"><i class="fa-solid fa-message"></i></span><span>Atribuir e SMS</span></button>
            <button type="button" class="button is-info" data-action="movimento" data-tipo="1" data-envio="email" data-submit><span class="icon"><i class="fa-regular fa-paper-plane"></i></span><span>Atribuir e email</span></button>
        </footer>
    </div>
</div>

<div id="modalDevolver" class="modal" role="dialog" aria-modal="true" aria-labelledby="tDev">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="tDev"><span class="icon"><i class="fa-solid fa-rotate-left"></i></span><span>Devolver território</span></p>
            <button type="button" class="delete" aria-label="Fechar" data-close></button>
        </header>
        <section class="modal-card-body">
            <p class="modal-body-text mb-4" id="devNome"></p>
            <div class="field">
                <label class="label" for="txtDataDevolver">Data de devolução</label>
                <input type="date" class="input" id="txtDataDevolver">
            </div>
            <div class="form-grid">
                <div class="field">
                    <label class="label" for="txtEmailDevolver">Email do publicador</label>
                    <input type="email" class="input" id="txtEmailDevolver" autocomplete="off">
                </div>
                <div class="field">
                    <label class="label" for="txtTelemovelDevolver">Telemóvel do publicador</label>
                    <input type="tel" class="input" id="txtTelemovelDevolver" autocomplete="off">
                </div>
            </div>
            <p class="field-hint">O território volta ao stock da congregação. O aviso por email ou SMS é opcional.</p>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button" data-action="movimento" data-tipo="2" data-envio="nenhum">Só devolver</button>
            <button type="button" class="button is-success is-light" data-action="movimento" data-tipo="2" data-envio="sms"><span class="icon"><i class="fa-solid fa-message"></i></span><span>Devolver e SMS</span></button>
            <button type="button" class="button is-success" data-action="movimento" data-tipo="2" data-envio="email" data-submit><span class="icon"><i class="fa-regular fa-paper-plane"></i></span><span>Devolver e email</span></button>
        </footer>
    </div>
</div>

<partial name="_ModalQr" />

@section Scripts {
<script>
    const M = id => App.modal(id);
    const hoje = () => { const d = new Date(); return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10); };
    let atual = null;

    // Estatísticas e pesquisa/filtro no browser; a lista é reconstruída pelo servidor após cada ação.
    App.filtro({
        lista: '#lista', input: '#filtro', chips: '#chips', vazio: '#vazio',
        aoAplicar: v => App.stats({
            sTot: v.length,
            sLivre: v.filter(i => i.dataset.livre === '1').length,
            sAtr: v.filter(i => i.dataset.livre === '0').length,
            sAt: v.filter(i => i.dataset.type.includes('atencao')).length
        })
    });

    async function preencher(idpub, emailSel, telSel) {
        App.$(emailSel).value = ''; App.$(telSel).value = '';
        if (!idpub || idpub === '0') return;
        try {
            const p = await App.api('GET', '/Publicadores/ObterPublicador/', { id: idpub });
            App.$(emailSel).value = p.email || ''; App.$(telSel).value = p.telemovel || '';
        } catch (e) { notifyError('Não foi possível obter os contactos do publicador.'); }
    }

    App.on('atribuir', btn => {
        atual = btn.closest('.item');
        App.$('#atrNome').textContent = atual.dataset.label; App.$('#txtData').value = hoje();
        App.$('#txtIdPublicador').value = ''; preencher('', '#txtEmailPublicador', '#txtTelemovelPublicador');
        M('modalAtribuir').open();
    });
    App.$('#txtIdPublicador').addEventListener('change', e => preencher(e.target.value, '#txtEmailPublicador', '#txtTelemovelPublicador'));

    App.on('devolver', btn => {
        atual = btn.closest('.item');
        App.$('#devNome').textContent = atual.dataset.label; App.$('#txtDataDevolver').value = hoje();
        preencher(atual.dataset.pub, '#txtEmailDevolver', '#txtTelemovelDevolver');
        M('modalDevolver').open();
    });

    // Atribuir/devolver, com envio opcional por email ou SMS (o email é enviado pelo servidor).
    App.on('movimento', btn => App.run(btn, async () => {
        const tipo = btn.dataset.tipo, envio = btn.dataset.envio, atribuir = tipo === '1';
        const modalId = atribuir ? 'modalAtribuir' : 'modalDevolver';
        const idpub = atribuir ? App.$('#txtIdPublicador').value : '0';
        const email = App.$(atribuir ? '#txtEmailPublicador' : '#txtEmailDevolver').value.trim();
        const tel = App.$(atribuir ? '#txtTelemovelPublicador' : '#txtTelemovelDevolver').value.trim();
        const data = App.$(atribuir ? '#txtData' : '#txtDataDevolver').value;

        if (atribuir && idpub === '') return App.campo('#txtIdPublicador', 'Escolha o publicador.');
        if (!data) return App.campo(atribuir ? '#txtData' : '#txtDataDevolver', 'Indique a data.');
        if (envio === 'email' && !email) return App.campo(atribuir ? '#txtEmailPublicador' : '#txtEmailDevolver', 'Indique o email para o enviar.');
        if (envio === 'sms' && !tel) return App.campo(atribuir ? '#txtTelemovelPublicador' : '#txtTelemovelDevolver', 'Indique o telemóvel para o SMS.');

        if (envio === 'sms') { // tem de abrir dentro do gesto do utilizador, antes do pedido
            const texto = atribuir ? 'Foi-lhe atribuído o seguinte território: ' + atual.dataset.label
                                   : 'Foi devolvido o seguinte território: ' + atual.dataset.label + '. Não o pode trabalhar mais!';
            window.open('sms://' + tel.replace(/\s/g, '') + '?body=' + encodeURIComponent(texto));
        }
        await App.api('POST', '/Territorios/Movimento/', {
            id: atual.dataset.stamp, idpub: idpub, email: envio === 'email' ? email : '', telemovel: envio === 'sms' ? tel : '', tipo: tipo, data: data
        });
        M(modalId).close(); await App.refresh('#lista'); notify(atribuir ? 'Território atribuído.' : 'Território devolvido.');
    }, 'Não foi possível registar o movimento.'));

    App.on('criar', btn => App.run(btn, async () => {
        const id = App.$('#txtIdTerritorio').value.trim(), nome = App.$('#txtNomeTerritorio').value.trim();
        if (!id) return App.campo('#txtIdTerritorio', 'Indique o número.');
        if (!nome) return App.campo('#txtNomeTerritorio', 'Indique o nome.');
        await App.api('PUT', '/Territorios/Territorio/', {
            id: id, nome: nome, dificuldade: App.$('#txtDificuldadeTerritorio').value,
            descricao: App.$('#txtDescricaoTerritorio').value, url: App.$('#txtURLTerritorio').value
        });
        M('modalNovo').close(); App.$$('#modalNovo input, #modalNovo textarea').forEach(i => i.value = '');
        await App.refresh('#lista'); notify('Território criado.');
    }, 'Não foi possível criar o território.'));

    App.on('apagar', async btn => {
        const it = btn.closest('.item');
        if (!await App.confirm({ title: 'Apagar território', text: 'Apagar «' + it.dataset.label + '» e todos os movimentos associados?', ok: 'Apagar' })) return;
        App.run(btn, async () => { await App.api('DELETE', '/Territorios/Territorio/', { stamp: it.dataset.stamp }); App.removeItem(it); notify('Território apagado.'); },
            'Não foi possível apagar o território.');
    });

    App.on('lerQr', () => App.qr(t => App.$('#txtURLTerritorio').value = t));
</script>
}
