<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<AssemblyVersion>3.2026.11.24</AssemblyVersion>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
		<None Update="Migrations\V_1.2_Moradas.sql">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Migrations\V_1.6_Mobilidade_Recomendacoes.sql">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.3.3" />
		<PackageReference Include="MailKit" Version="5.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
		<PackageReference Include="MySql.Simple" Version="5.3.5" />
		<PackageReference Include="MySqlBackup.NET" Version="2.3.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Versões mínimas sem vulnerabilidades conhecidas das dependências indiretas (iTextSharp e MySqlBackup). -->
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup>
		<None Update="S-28_TPO.pdf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>		
	    <None Include="Migrations\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
	</ItemGroup>
</Project>
